+                 elite_factor: float = 0.4,      # Elite archive ratio
+                 disp: bool = True,              # Verbose runtime logs
+                 parallelize: bool = False,      # Parallel objective evaluation
+                 init_data: np.array = None,     # Optional seeded initial population
+                 w_noise: float = 0.5,           # Additive exploration noise
+                 selection_strategy=None,        # Selection policy (e.g., NSGA-II)
+                 detector: dict = None,          # Drift detector config block
+                 reaction: dict = None,          # Reaction policy config block
+                 local_search: dict = None):     # Pareto local-search config block
+
+        super().__init__(size_gen, max_iter, dead_iter,
+                         n_variables, alpha,
+                         elite_factor, disp,
+                         parallelize, init_data,
+                         w_noise, selection_strategy)
+
+        detector_cfg, reaction_cfg, local_search_cfg = self._resolve_config_blocks(
+            detector=detector,
+            reaction=reaction,
+            local_search=local_search,
+        )
+
+        # Drift detector config
+        self.n_sentinels = max(1, int(detector_cfg["n_sentinels"]))
+        self.drift_alpha = float(detector_cfg["drift_alpha"])
+        self.lambda_ewma = float(detector_cfg["lambda_ewma"])
+        self.drift_alpha_mean = float(np.clip(detector_cfg["drift_alpha_mean"], 1e-9, 1.0 - 1e-9))
+        self.lambda_ewma_mean = float(np.clip(detector_cfg["lambda_ewma_mean"], 0.0, 1.0))
+        self.lambda_ewma_cov = float(np.clip(detector_cfg["lambda_ewma_cov"], 0.0, 1.0))
+        self.sentinel_refresh = max(1, int(detector_cfg["sentinel_refresh"]))
+        self.k_consecutive = max(1, int(detector_cfg["k_consecutive"]))
+        self.normalize_objectives = bool(detector_cfg["normalize_objectives"])
+        self.detector_scale_eps = max(float(detector_cfg["detector_scale_eps"]), 1e-12)
+        self.cov_regularization_eps = max(float(detector_cfg["cov_regularization_eps"]), 1e-12)
+        self.cov_regularization_shrink = float(np.clip(detector_cfg["cov_regularization_shrink"], 0.0, 1.0))
+        self.cov_condition_max = max(float(detector_cfg["cov_condition_max"]), 1.0)
+        self.split_drift_signals = bool(detector_cfg["split_drift_signals"])
