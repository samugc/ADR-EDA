+    # Initialize and validate config blocks, applying defaults and checking for unknown keys
+    @classmethod
+    def _resolve_config_blocks(cls,
+                               detector: dict,
+                               reaction: dict,
+                               local_search: dict):
+        # Helper function to merge defaults with provided config, validating types and keys
+        def _merge_block(defaults: dict, provided: dict, block_name: str) -> dict:
+            cfg = dict(defaults)
+            if provided is None:
+                return cfg
+            if not isinstance(provided, dict):
+                raise TypeError(f"DynamicEDA '{block_name}' must be a dict, got {type(provided).__name__}")
+            unknown = sorted(set(provided.keys()) - set(defaults.keys()))
+            if unknown:
+                unknown_str = ", ".join(unknown)
+                raise TypeError(f"Unexpected DynamicEDA {block_name} keys: {unknown_str}")
+            cfg.update(provided)
+            return cfg
+
+        detector_cfg = _merge_block(cls._DEFAULT_DETECTOR, detector, "detector")
+        reaction_cfg = _merge_block(cls._DEFAULT_REACTION, reaction, "reaction")
+        local_search_cfg = _merge_block(cls._DEFAULT_LOCAL_SEARCH, local_search, "local_search")
+
+        return detector_cfg, reaction_cfg, local_search_cfg
+
+    @staticmethod
+    def _normalize_positive_weights(values: np.ndarray) -> np.ndarray:
+        weights = np.asarray(values, dtype=float)
+        weights = np.clip(weights, 0.0, None)
+        if np.sum(weights) <= 1e-12:
+            weights = np.ones_like(weights, dtype=float)
+        return weights / np.sum(weights)
