+        settings.update({
+            "n_sentinels": self.n_sentinels,
+            "drift_alpha": self.drift_alpha,
+            "react_strength": self.react_strength,
+            "react_strength_mild": self.react_strength_mild,
+            "react_strength_medium": self.react_strength_medium,
+            "severity_high": self.severity_high,
+            "immigrant_ratio": self.immigrant_ratio,
+            "immigrant_ratio_mild": self.immigrant_ratio_mild,
+            "immigrant_ratio_medium": self.immigrant_ratio_medium,
+            "adaptive_policy_enabled": self.adaptive_policy_enabled,
+            "profile_threshold_medium": self.profile_threshold_medium,
+            "profile_threshold_severe": self.profile_threshold_severe,
+            "adaptive_weight_severity": self.adaptive_weight_severity,
+            "adaptive_weight_recency": self.adaptive_weight_recency,
+            "adaptive_weight_trend": self.adaptive_weight_trend,
+            "adaptive_recency_scale": self.adaptive_recency_scale,
+            "adaptive_trend_window": self.adaptive_trend_window,
+            "reaction_min_drift_ratio": self.reaction_min_drift_ratio,
+            "reaction_min_interval": self.reaction_min_interval,
+            "reaction_window": self.reaction_window,
+            "reaction_max_calls_in_window": self.reaction_max_calls_in_window,
+            "reaction_max_calls_mild_window": self.reaction_max_calls_mild_window,
+            "reaction_max_calls_medium_window": self.reaction_max_calls_medium_window,
+            "reaction_max_calls_severe_window": self.reaction_max_calls_severe_window,
+            "reaction_quality_gate_enabled": self.reaction_quality_gate_enabled,
+            "reaction_quality_gate_rel_tol": self.reaction_quality_gate_rel_tol,
+            "reaction_quality_gate_abs_tol": self.reaction_quality_gate_abs_tol,
+            "reaction_quality_gate_mo_enabled": self.reaction_quality_gate_mo_enabled,
+            "reaction_quality_gate_mo_rel_tol": self.reaction_quality_gate_mo_rel_tol,
+            "reaction_quality_gate_mo_size_tol": self.reaction_quality_gate_mo_size_tol,
+            "reaction_quality_gate_mo_strategy": self.reaction_quality_gate_mo_strategy,
+            "reaction_quality_gate_mo_dominance_margin": self.reaction_quality_gate_mo_dominance_margin,
+            "memory_enabled": self.memory_enabled,
+            "memory_topk": self.memory_topk,
+            "memory_max_size": self.memory_max_size,
+            "memory_match_threshold": self.memory_match_threshold,
+            "memory_inject_ratio": self.memory_inject_ratio,
+            "memory_min_archive_size": self.memory_min_archive_size,
+            "memory_min_interval": self.memory_min_interval,
