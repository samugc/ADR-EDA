+import numpy as np
+from abc import ABC, abstractmethod
+
+class NSGA2Utils:
+    @staticmethod
+    def fast_non_dominated_sort(objectives):
+        N = objectives.shape[0]
+        S = [[] for _ in range(N)]
+        fronts = [[]]
+        n = np.zeros(N, dtype=int)
+        rank = np.zeros(N, dtype=int)
+
+        for p in range(N):
+            S[p] = []
+            n[p] = 0
+            for q in range(N):
+                # Dominancia clásica
+                if NSGA2Utils._dominates(objectives[p], objectives[q]):
+                    S[p].append(q)
+                elif NSGA2Utils._dominates(objectives[q], objectives[p]):
+                    n[p] += 1
+            if n[p] == 0:
+                rank[p] = 0
+                fronts[0].append(p)
+
+        i = 0
+        while len(fronts[i]) > 0:
+            next_front = []
+            for p in fronts[i]:
+                for q in S[p]:
+                    n[q] -= 1
+                    if n[q] == 0:
+                        rank[q] = i + 1
+                        next_front.append(q)
+            i += 1
+            if len(next_front) > 0:
+                fronts.append(next_front)
+            else:
+                break
+        return fronts
+
+    @staticmethod
+    def _dominates(obj1, obj2):
+        # Minimización: obj1 domina a obj2 si es <= en todo y < en al menos uno
+        return np.all(obj1 <= obj2) and np.any(obj1 < obj2)
+
+    @staticmethod
+    def calculate_crowding_distance(objectives, front_indices):
+        """
+        Calcula la distancia de hacinamiento NORMALIZADA.
+        Esto hace al algoritmo robusto ante objetivos con escalas muy diferentes.
+        """
+        l = len(front_indices)
+        if l == 0: return {}
+        
+        distances = {idx: 0.0 for idx in front_indices}
+        n_obj = objectives.shape[1]
+        
+        # Obtenemos solo las soluciones del frente actual para calcular min/max locales
+        front_objs = objectives[front_indices]
+        
+        for m in range(n_obj):
+            # Ordenamos índices basándonos en el objetivo m
+            sorted_indices = sorted(front_indices, key=lambda x: objectives[x, m])
+            
+            # Los extremos siempre tienen distancia infinita (se mantienen)
+            distances[sorted_indices[0]] = np.inf
+            distances[sorted_indices[-1]] = np.inf
+            
+            # --- MEJORA DE ROBUSTEZ: Normalización ---
+            # Calculamos el rango del objetivo m en este frente
+            m_values = front_objs[:, m]
+            scale = m_values.max() - m_values.min()
+            
+            # Si todos los valores son iguales, scale es 0. Evitamos división por cero.
+            if scale == 0: scale = 1.0
+            # -----------------------------------------
+
+            for i in range(1, l - 1):
+                prev = sorted_indices[i-1]
+                next_ind = sorted_indices[i+1]
+                curr = sorted_indices[i]
+                
+                # Distancia normalizada
+                distances[curr] += (objectives[next_ind, m] - objectives[prev, m]) / scale
+                
+        return distances
+
+    @staticmethod
+    def rank_distance_order(objectives, indices_to_sort):
+        """
+        Devuelve un orden total por rank y crowding distance.
+        Permite reutilizar una sola ordenación para extraer diferentes prefijos.
+        """
+        fronts = NSGA2Utils.fast_non_dominated_sort(objectives[indices_to_sort])
+        ordered = []
+
+        for front in fronts:
+            abs_front = [indices_to_sort[i] for i in front]
+            if len(abs_front) == 0:
+                continue
+
+            distances = NSGA2Utils.calculate_crowding_distance(objectives, abs_front)
+            sorted_front = sorted(abs_front, key=lambda x: distances[x], reverse=True)
+            ordered.extend(sorted_front)
+
+        return np.array(ordered, dtype=int)
+
+    @staticmethod
+    def sort_by_rank_and_distance(objectives, indices_to_sort, n_survivors):
+        ordered = NSGA2Utils.rank_distance_order(objectives, indices_to_sort)
+        return ordered[:n_survivors]
+
+class SelectionStrategy(ABC):
+    @abstractmethod
+    def select(self, X, F, elite_size, truncation_size):
+        pass
+
+class NSGA2Selection(SelectionStrategy):
+    def select(self, X, F, elite_size, truncation_size):
+        all_idx = np.arange(len(X))
+
+        # Ordenación única rank+crowding para extraer élite y truncamiento.
+        ordered_idx = NSGA2Utils.rank_distance_order(F, all_idx)
+        elite_idx = ordered_idx[:elite_size]
+        trunc_idx = ordered_idx[:truncation_size]
+        
+        return (X[elite_idx], F[elite_idx], X[trunc_idx], F[trunc_idx])
