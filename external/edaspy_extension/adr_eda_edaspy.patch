+#!/usr/bin/env python
+# coding: utf-8
+
+import time
+from typing import List, Union
+
+import numpy as np
+from scipy.stats import chi2
+
+from .speda import SPEDA
+from ..selection import NSGA2Selection
+from ..utils import _parallel_apply_along_axis
+
+
+class DynamicSPEDA(SPEDA):
+    """
+    Dynamic extension of SPEDA.
+
+    Design goals:
+    1) Keep SPEDA archive-based semantics.
+    2) Detect environmental drift from sentinel solutions.
+    3) React without model-specific hacks over pybnesian internals.
+       Reaction is done over population + archive + transient fitting settings.
+    """
+
+    def __init__(
+        self,
+        size_gen: int,
+        max_iter: int,
+        dead_iter: int,
+        n_variables: int,
+        lower_bound: Union[np.array, List[float], float] = None,
+        upper_bound: Union[np.array, List[float], float] = None,
+        l: float = 10,
+        alpha: float = 0.5,
+        disp: bool = True,
+        black_list: list = None,
+        white_list: list = None,
+        parallelize: bool = False,
+        init_data: np.array = None,
+        w_noise: float = 0.5,
+        selection_strategy=None,
+        # --- Dynamic parameters ---
+        n_sentinels: int = 12,
+        drift_alpha: float = 0.01,
+        lambda_ewma: float = 0.3,
+        sentinel_refresh: int = 10,
+        k_consecutive: int = 2,
+        severity_high: float = 2.0,
+        immigrant_ratio: float = 0.30,
+        immigrant_ratio_mild: float = 0.12,
+        react_noise: float = 0.40,
+        react_noise_mild: float = 0.18,
+        archive_keep_ratio: float = 0.35,
+        archive_keep_ratio_mild: float = 0.70,
+        num_folds_default: int = 10,
+        num_folds_after_change: int = 5,
+        adapt_cooldown_iters: int = 3,
+    ):
+        super().__init__(
+            size_gen=size_gen,
+            max_iter=max_iter,
+            dead_iter=dead_iter,
+            n_variables=n_variables,
+            lower_bound=lower_bound,
+            upper_bound=upper_bound,
+            l=l,
+            alpha=alpha,
+            disp=disp,
+            black_list=black_list,
+            white_list=white_list,
+            parallelize=parallelize,
+            init_data=init_data,
+            w_noise=w_noise,
+        )
+
+        # MO strategy can be injected explicitly from caller. If None, auto-detect in minimize.
+        self.selection_strategy = selection_strategy
+
+        # Dynamic config.
+        self.n_sentinels = max(2, int(n_sentinels))
+        self.drift_alpha = float(drift_alpha)
+        self.lambda_ewma = float(lambda_ewma)
+        self.sentinel_refresh = max(1, int(sentinel_refresh))
+        self.k_consecutive = max(1, int(k_consecutive))
+        self.severity_high = max(float(severity_high), 1.01)
+
+        self.immigrant_ratio = float(immigrant_ratio)
+        self.immigrant_ratio_mild = float(immigrant_ratio_mild)
+        self.react_noise = float(react_noise)
+        self.react_noise_mild = float(react_noise_mild)
+        self.archive_keep_ratio = float(archive_keep_ratio)
+        self.archive_keep_ratio_mild = float(archive_keep_ratio_mild)
+
+        self.num_folds_default = max(2, int(num_folds_default))
+        self.num_folds_after_change = max(2, int(num_folds_after_change))
+        self.adapt_cooldown_iters = max(0, int(adapt_cooldown_iters))
+
+        # Dynamic runtime state.
+        self.env_changes = 0
+        self.sentinel_indices = None
+        self.mu_old = None
+        self.cov_old = None
+        self.ewma_stat = 0.0
+        self._sentinel_age = 0
+        self._consecutive_alerts = 0
+        self._last_drift_ratio = 0.0
+        self._adapt_cooldown = 0
+        self._react_noise_cooldown = 0
+
+    # -------------------------
+    # Internal helpers
+    # -------------------------
+    def _bounds_arrays(self) -> (np.ndarray, np.ndarray):
+        lb_raw = getattr(self.init, "lower_bound", -100.0)
+        ub_raw = getattr(self.init, "upper_bound", 100.0)
+
+        if lb_raw is None:
+            lb_raw = -100.0
+        if ub_raw is None:
+            ub_raw = 100.0
+
+        lb = np.asarray(lb_raw, dtype=float)
+        ub = np.asarray(ub_raw, dtype=float)
+
+        if lb.ndim == 0:
+            lb = np.full(self.n_variables, float(lb), dtype=float)
+        if ub.ndim == 0:
+            ub = np.full(self.n_variables, float(ub), dtype=float)
+
+        lb = lb.reshape(self.n_variables)
+        ub = ub.reshape(self.n_variables)
+        return lb, ub
+
+    def _clip_generation(self) -> None:
+        lb, ub = self._bounds_arrays()
+        self.generation = np.clip(self.generation, lb, ub)
+
+    def _severity_fraction(self) -> float:
+        severity = max(self._last_drift_ratio, 1.0)
+        span = max(self.severity_high - 1.0, 1e-12)
+        return float(np.clip((severity - 1.0) / span, 0.0, 1.0))
+
+    def _evaluate_subset(self, objective_function, subset: np.ndarray) -> np.ndarray:
+        if self.parallelize:
+            vals = _parallel_apply_along_axis(objective_function, 1, subset)
+        else:
+            vals = np.apply_along_axis(objective_function, 1, subset)
+
+        vals = np.asarray(vals)
+        if vals.ndim == 1:
+            vals = vals.reshape(-1, 1)
+        return vals
+
+    # -------------------------
+    # Sentinel drift detection
+    # -------------------------
+    def _update_sentinels(self, force: bool = False) -> None:
+        need_refresh = (
+            force
+            or self.sentinel_indices is None
+            or self._sentinel_age >= self.sentinel_refresh
+        )
+        if not need_refresh:
+            self._sentinel_age += 1
+            return
+
+        pop_size = len(self.generation)
+        k = min(self.n_sentinels, pop_size)
+        self.sentinel_indices = np.random.choice(pop_size, k, replace=False)
+
+        sent_fit = self.evaluations[self.sentinel_indices]
+        sent_fit = np.asarray(sent_fit)
+        if sent_fit.ndim == 1:
+            sent_fit = sent_fit.reshape(-1, 1)
+
+        self.mu_old = np.mean(sent_fit, axis=0)
+        self.cov_old = np.cov(sent_fit.T)
+
+        if np.ndim(self.cov_old) == 0:
+            self.cov_old = np.array([[self.cov_old]], dtype=float)
+
+        self.cov_old += 1e-6 * np.eye(self.cov_old.shape[0])
+        self._sentinel_age = 0
+
+    def _detect_change(self, objective_function) -> bool:
+        if self.sentinel_indices is None or self.mu_old is None or self.cov_old is None:
+            return False
+
+        sentinel_genomes = self.generation[self.sentinel_indices]
+        new_vals = self._evaluate_subset(objective_function, sentinel_genomes)
+
+        mu_new = np.mean(new_vals, axis=0)
+        diff = mu_new - self.mu_old
+
+        try:
+            inv_cov = np.linalg.inv(self.cov_old)
+        except np.linalg.LinAlgError:
+            inv_cov = np.linalg.pinv(self.cov_old)
+
+        mahalanobis_sq = diff.T @ inv_cov @ diff
+        if isinstance(mahalanobis_sq, np.ndarray):
+            mahalanobis_sq = mahalanobis_sq.item()
+
+        self.ewma_stat = self.lambda_ewma * mahalanobis_sq + (1.0 - self.lambda_ewma) * self.ewma_stat
+
+        dof = mu_new.shape[0]
+        threshold = chi2.ppf(1 - self.drift_alpha, dof)
+        self._last_drift_ratio = self.ewma_stat / max(threshold, 1e-12)
+
+        if self.ewma_stat > threshold:
+            self._consecutive_alerts += 1
+        else:
+            self._consecutive_alerts = 0
+
+        if self._consecutive_alerts >= self.k_consecutive:
+            if self.disp:
+                print(
+                    " [DynamicSPEDA] Drift detectado "
+                    f"(EWMA: {self.ewma_stat:.4f} > Chi2: {threshold:.4f}, "
+                    f"ratio={self._last_drift_ratio:.2f}, k={self._consecutive_alerts})"
+                )
+            return True
+
+        return False
+
+    # -------------------------
+    # Reaction mechanism
+    # -------------------------
+    def _react(self) -> None:
+        self.env_changes += 1
+        self.ewma_stat = 0.0
+        self._consecutive_alerts = 0
+
+        frac = self._severity_fraction()
+
+        imm_ratio = self.immigrant_ratio_mild + frac * (self.immigrant_ratio - self.immigrant_ratio_mild)
+        n_imm = int(self.size_gen * imm_ratio)
+
+        keep_ratio = self.archive_keep_ratio_mild + frac * (self.archive_keep_ratio - self.archive_keep_ratio_mild)
+        keep_ratio = float(np.clip(keep_ratio, 0.05, 1.0))
+
+        react_sigma = self.react_noise_mild + frac * (self.react_noise - self.react_noise_mild)
+
+        if self.disp:
+            print(
+                f" [DynamicSPEDA] Reaccion iniciada (Cambio #{self.env_changes}) "
+                f"[severity={max(self._last_drift_ratio, 1.0):.2f}, sigma={react_sigma:.2f}, "
+                f"immigrants={n_imm}, archive_keep={keep_ratio:.2f}]"
+            )
+
+        # A) Forget a part of historical archive to avoid stale model memory.
+        if len(self.archive) > 0:
+            n_keep = max(self.elite_length, int(len(self.archive) * keep_ratio))
+            self.archive = self.archive[-n_keep:]
+
+        # B) Inject immigrants inside bounds.
+        if n_imm > 0:
+            lb, ub = self._bounds_arrays()
+            mean = np.mean(self.generation, axis=0)
+            std = np.std(self.generation, axis=0)
+            std = np.where(std < 1e-3, 0.1, std)
+
+            n_gauss = n_imm // 2
+            gaussian_imm = np.random.normal(mean, std * max(react_sigma, 1e-6), (n_gauss, self.n_variables))
+            uniform_imm = np.random.uniform(lb, ub, (n_imm - n_gauss, self.n_variables))
+            immigrants = np.vstack([gaussian_imm, uniform_imm])
+            immigrants = np.clip(immigrants, lb, ub)
+
+            replace_idx = np.random.choice(len(self.generation), n_imm, replace=False)
+            self.generation[replace_idx] = immigrants
+
+        # C) Trigger temporary fast adaptation for PM fitting.
+        self._adapt_cooldown = self.adapt_cooldown_iters
+        self._react_noise_cooldown = self.adapt_cooldown_iters
+
+    # -------------------------
+    # SPEDA hooks (archive + PM)
+    # -------------------------
+    def _update_pm(self):
+        self._update_archive()
+
+        if len(self.archive) == 0:
+            return
+
+        folds = self.num_folds_default
+        if self._adapt_cooldown > 0:
+            folds = self.num_folds_after_change
+            self._adapt_cooldown -= 1
+
+        self.pm.learn(dataset=self.archive, num_folds=folds)
+
+    # -------------------------
+    # Main optimization loop
+    # -------------------------
+    def minimize(self, cost_function, output_runtime=True, ftol=1e-8, *args, **kwargs):
+        history = []
+        t1 = time.process_time()
+
+        # Initialization.
+        self.generation = self._initialize_generation()
+        self._clip_generation()
+
+        self.elite_temp = np.empty((0, self.n_variables))
+        self.evaluations_elite = np.array([])
+
+        self._check_generation(cost_function)
+
+        # Auto inject NSGA-II for MO if needed.
+        if self.selection_strategy is None:
+            if self.evaluations.ndim > 1 and self.evaluations.shape[1] > 1:
+                if output_runtime:
+                    print(f" [Auto] Detectado problema Multiobjetivo ({self.evaluations.shape[1]} objs).")
+                self.selection_strategy = NSGA2Selection()
+
+        is_multiobjective = self.selection_strategy is not None
+
+        if is_multiobjective:
+            self.evaluations_elite = np.empty((0, self.evaluations.shape[1]))
+            self._truncation()
+        else:
+            best_idx = np.argmin(self.evaluations)
+            self.best_mae_global = self.evaluations[best_idx]
+            self.best_ind_global = self.generation[best_idx]
+            history.append(self.best_mae_global)
+            if output_runtime:
+                print(f"IT: 0\tBest cost: {self.best_mae_global:.4f}")
+
+        # Initialize sentinels.
+        self._update_sentinels(force=True)
+
+        # Optional dead-iteration tracking for SO mode.
+        no_improve = 0
+
+        for i in range(1, self.max_iter):
+            # A) Drift detection and reaction.
+            if self._detect_change(cost_function):
+                self._react()
+                self._clip_generation()
+                self._check_generation(cost_function)
+                self._update_sentinels(force=True)
+
+            # B) Standard EDA flow.
+            self._truncation()
+
+            noise_sigma = self.w_noise
+            if self._react_noise_cooldown > 0:
+                noise_sigma += self.react_noise
+                self._react_noise_cooldown -= 1
+
+            if noise_sigma > 0:
+                self.generation += np.random.normal(0, noise_sigma, self.generation.shape)
+                self._clip_generation()
+
+            self._update_pm()
+            self._new_generation()
+            self._clip_generation()
+            self._check_generation(cost_function)
+
+            # C) Logging/stop conditions.
+            if not is_multiobjective:
+                best_local = np.min(self.evaluations)
+                history.append(best_local)
+
+                if best_local < self.best_mae_global * (1 + ftol):
+                    self.best_mae_global = best_local
+                    self.best_ind_global = self.generation[np.argmin(self.evaluations)]
+                    no_improve = 0
+                else:
+                    no_improve += 1
+
+                if output_runtime and i % 5 == 0:
+                    print(f"IT {i} | Best: {self.best_mae_global:.6f} | EWMA: {self.ewma_stat:.2e}")
+
+                if no_improve >= self.dead_iter:
+                    if output_runtime:
+                        print(f" [DynamicSPEDA] Stopping early by dead_iter={self.dead_iter}")
+                    break
+            else:
+                if output_runtime and i % 10 == 0:
+                    print(
+                        f"IT {i} | Elite Archive Size: {len(self.evaluations_elite)} "
+                        f"| EWMA: {self.ewma_stat:.2e} | EnvChanges: {self.env_changes}"
+                    )
+
+            # D) Sentinel maintenance.
+            self._update_sentinels()
+
+        t2 = time.process_time()
+
+        if is_multiobjective:
+            return {
+                "pareto_set": self.elite_temp,
+                "pareto_front": self.evaluations_elite,
+                "cpu_time": t2 - t1,
+                "env_changes": self.env_changes,
+                "settings": self.export_settings(),
+            }
+
+        from ..eda_result import EdaResult
+
+        return EdaResult(
+            self.best_ind_global,
+            self.best_mae_global,
+            len(history) * self.size_gen,
+            history,
+            self.export_settings(),
+            t2 - t1,
+        )
