+        self._anchor_history = deque(maxlen=max(4, self.adaptive_trend_window))
+        self._drift_ratio_history = deque(maxlen=max(6, self.adaptive_trend_window))
+        self._change_step_history = deque(maxlen=max(5, self.adaptive_trend_window))
+        self._adr_block_credit = {
+            "stable": np.ones(4, dtype=float),
+            "uncertain": np.ones(4, dtype=float),
+            "abrupt": np.ones(4, dtype=float),
+        }
+        self._is_initialized_dynamic = False
+        self._is_multiobjective_dynamic = False
+
+    # Translate a 1D array to 2D.
+    @staticmethod
+    def _as_2d(values: np.ndarray) -> np.ndarray:
+        vals = np.asarray(values, dtype=float)
+        if vals.ndim == 1:
+            return vals.reshape(-1, 1)
+        return vals
+
+    # Translate a scalar or 1D array to a single float value.
+    @staticmethod
+    def _as_scalar(value) -> float:
+        arr = np.asarray(value)
+        if arr.ndim == 0:
+            return float(arr)
+        return float(arr.reshape(-1)[0])
+
+    # Estimate covariance matrix from samples.
+    def _cov_from_samples(self, values: np.ndarray) -> np.ndarray:
+        vals = self._as_2d(values)
+        if vals.shape[0] <= 1:
+            return np.eye(vals.shape[1], dtype=float)
+        cov = np.cov(vals, rowvar=False, bias=False)
+        if np.ndim(cov) == 0:
+            cov = np.array([[cov]], dtype=float)
+        return np.asarray(cov, dtype=float)
+
+    # Regularize covariance matrix to ensure numerical stability, applying shrinkage and diagonal loading as configured.
+    def _regularize_covariance(self, cov: np.ndarray) -> np.ndarray:
+        cov = np.asarray(cov, dtype=float)
+        if np.ndim(cov) == 0:
+            cov = np.array([[cov]], dtype=float)
+        cov = 0.5 * (cov + cov.T)
+        if self.cov_regularization_shrink > 0.0:
+            diag = np.diag(np.diag(cov))
+            cov = (1.0 - self.cov_regularization_shrink) * cov + self.cov_regularization_shrink * diag
+        cov = cov + self.cov_regularization_eps * np.eye(cov.shape[0], dtype=float)
+        return cov
+
+    # Compute a stable inverse of the covariance matrix, using pseudo-inverse if the condition number is too high or if inversion fails.
+    def _stable_inverse(self, cov: np.ndarray) -> np.ndarray:
+        try:
+            cond = np.linalg.cond(cov)
+        except np.linalg.LinAlgError:
+            cond = np.inf
+        if (not np.isfinite(cond)) or cond > self.cov_condition_max:
+            return np.linalg.pinv(cov)
+        try:
+            return np.linalg.inv(cov)
+        except np.linalg.LinAlgError:
+            return np.linalg.pinv(cov)
+
+    # Compute Hotelling's T-squared statistic for mean shift detection between two distributions with given means, covariances, and sample sizes.
+    def _hotelling_t2(self,
+                      mu_prev: np.ndarray,
+                      mu_curr: np.ndarray,
+                      cov_prev: np.ndarray,
+                      cov_curr: np.ndarray,
+                      n_prev: int,
+                      n_curr: int) -> float:
+        n_prev = max(int(n_prev), 1)
+        n_curr = max(int(n_curr), 1)
+        if n_prev > 1 and n_curr > 1:
+            pooled = ((n_prev - 1) * cov_prev + (n_curr - 1) * cov_curr) / max(n_prev + n_curr - 2, 1)
+        else:
+            pooled = cov_prev
+        pooled = self._regularize_covariance(pooled)
+        pooled_inv = self._stable_inverse(pooled)
+        delta = (np.asarray(mu_curr, dtype=float) - np.asarray(mu_prev, dtype=float)).reshape(-1, 1)
+        coef = (n_prev * n_curr) / max(n_prev + n_curr, 1)
+        t2 = coef * (delta.T @ pooled_inv @ delta)
+        return self._as_scalar(t2)
+
+    # Compute the log-determinant of a symmetric positive-definite matrix, returning infinity if the matrix is not valid.
+    @staticmethod
+    def _logdet_spd(mat: np.ndarray) -> float:
+        sign, val = np.linalg.slogdet(mat)
+        if sign <= 0:
+            return np.inf
+        return float(val)
+
+    # Compute the Stein divergence between two covariance matrices, using regularization and log-determinant calculations for stability.
+    def _stein_divergence(self, cov_prev: np.ndarray, cov_curr: np.ndarray) -> float:
+        s0 = self._regularize_covariance(cov_prev)
+        s1 = self._regularize_covariance(cov_curr)
+        mid = 0.5 * (s0 + s1)
+        ld_mid = self._logdet_spd(mid)
+        ld_0 = self._logdet_spd(s0)
+        ld_1 = self._logdet_spd(s1)
+        if not np.isfinite(ld_mid) or not np.isfinite(ld_0) or not np.isfinite(ld_1):
+            return np.inf
+        return float(max(ld_mid - 0.5 * (ld_0 + ld_1), 0.0))
+
+    # Adaptively compute the EWMA lambda parameter based on the relative variance of recent values in the specified channel (mean or covariance), 
+    # allowing for dynamic adjustment of sensitivity to changes.
+    def _adaptive_lambda(self, value: float, channel: str) -> float:
+        buffer = self._ewma_cov_buffer if channel == "cov" else self._ewma_mean_buffer
+        buffer.append(float(value))
+        if len(buffer) < 5:
+            return self.adaptive_lambda_max
+
+        arr = np.asarray(buffer, dtype=float)
+        variance = float(np.var(arr))
+        mean = float(np.mean(arr))
+        rel_var = variance / (mean * mean + self.detector_scale_eps)
+        t = rel_var / (rel_var + self.adaptive_lambda_mid_relvar)
+        lam = self.adaptive_lambda_max - t * (self.adaptive_lambda_max - self.adaptive_lambda_min)
+        return float(np.clip(lam, self.adaptive_lambda_min, self.adaptive_lambda_max))
+
+    # Update the EWMA statistic for the specified channel (mean or covariance) with the new value, applying adaptive lambda if enabled, 
+    # and return the updated statistic.
+    def _update_ewma_channel(self, value: float, channel: str) -> float:
+        value = float(value)
+        if channel == "cov":
+            adaptive = self.adaptive_lambda_cov_enabled
+            base_lambda = self.lambda_ewma_cov
+            if adaptive:
+                lam = self._adaptive_lambda(value, channel="cov")
+            else:
+                self._ewma_cov_buffer.append(value)
+                lam = base_lambda
+            self.ewma_cov_stat = lam * value + (1.0 - lam) * self.ewma_cov_stat
+            self._last_lambda_cov = float(lam)
+            return float(self.ewma_cov_stat)
+
+        adaptive = self.adaptive_lambda_enabled
+        base_lambda = self.lambda_ewma_mean if self.split_drift_signals else self.lambda_ewma
+        if adaptive:
+            lam = self._adaptive_lambda(value, channel="mean")
+        else:
+            self._ewma_mean_buffer.append(value)
+            lam = base_lambda
+        self.ewma_stat = lam * value + (1.0 - lam) * self.ewma_stat
+        self._last_lambda_mean = float(lam)
+        return float(self.ewma_stat)
+
+    # Compute the covariance change threshold based on the EWMA of recent covariance divergence scores, 
+    # using a mean-plus-k-times-std heuristic, and applying a floor to ensure a minimum threshold.
+    def _cov_threshold(self) -> float:
+        if len(self._cov_baseline_ewma) < self.cov_baseline_min_samples:
+            return np.inf
+        baseline = np.asarray(self._cov_baseline_ewma, dtype=float)
+        mean = float(np.mean(baseline))
+        std = float(np.std(baseline))
+        thr = mean + self.cov_threshold_k * std
+        if not np.isfinite(thr):
+            return np.inf
+        return float(max(thr, self.cov_threshold_floor))
+
+    # Evaluate the cost function on a set of points, applying parallelization if enabled, and ensuring the output is in a consistent 2D 
+    # format for multi-objective handling.
+    def _evaluate_points(self, cost_function, points: np.ndarray) -> np.ndarray:
+        points = np.asarray(points, dtype=float)
+        if points.size == 0:
+            if self._is_multiobjective_dynamic and self.evaluations.ndim > 1:
+                return np.empty((0, self.evaluations.shape[1]))
+            return np.array([])
+
+        if self.parallelize:
+            from .utils import _parallel_apply_along_axis
+            vals = _parallel_apply_along_axis(cost_function, 1, points)
+        else:
+            vals = np.apply_along_axis(cost_function, 1, points)
+
+        vals = np.asarray(vals, dtype=float)
+        if vals.ndim == 1 and self._is_multiobjective_dynamic:
+            vals = vals.reshape(-1, 1)
+        return vals
+
+    # Prune points that are dominated by the given front values, returning only those that are non-dominated with respect to the front.
+    @staticmethod
+    def _prune_dominated_by_front(points: np.ndarray, values: np.ndarray, front_values: np.ndarray):
+        if points.size == 0 or values.size == 0 or front_values is None or front_values.size == 0:
+            return points, values
+        front = np.asarray(front_values, dtype=float)
+        vals = np.asarray(values, dtype=float)
+        le = np.all(front[:, None, :] <= vals[None, :, :], axis=2)
+        lt = np.any(front[:, None, :] < vals[None, :, :], axis=2)
+        dominated = np.any(le & lt, axis=0)
+        keep = ~dominated
+        return points[keep], vals[keep]
+
+    # Select the top n_keep points based on their values, using the selection strategy if provided, or sorting by the sum of values for multi-objective cases.
+    def _select_top_local(self, points: np.ndarray, values: np.ndarray, n_keep: int):
+        n_keep = int(max(1, min(n_keep, len(points))))
+        if len(points) <= n_keep:
+            return points, values
+        if self.selection_strategy is not None:
+            sel_X, sel_F, _, _ = self.selection_strategy.select(points, values, n_keep, n_keep)
+            return sel_X, sel_F
+        vals = np.asarray(values, dtype=float)
+        if vals.ndim == 1:
+            vals = vals.reshape(-1, 1)
+        ordering = np.argsort(np.sum(vals, axis=1))
+        idx = ordering[:n_keep]
+        return points[idx], vals[idx]
+
+    # Generate local search neighbors around the given base points using Gaussian perturbations, applying clipping to bounds if specified.
+    def _local_search_neighbors_gaussian(self, bases: np.ndarray, step_vec: np.ndarray, clip_bounds):
+        neighbors = []
+        for b in bases:
+            noise = np.random.normal(0.0, step_vec, size=(self.local_search_neighbors, self.n_variables))
+            neighbors.append(b + noise)
+        neighbors = np.vstack(neighbors)
+        if clip_bounds is not None:
+            neighbors = np.clip(neighbors, clip_bounds[0], clip_bounds[1])
+        return neighbors
+
+    # Generate local search neighbors around the given base points using a tube-and-beam strategy.
+    def _local_search_neighbors_tube_beam(self,
+                                          cost_function,
+                                          bases: np.ndarray,
+                                          base_vals: np.ndarray,
+                                          step_vec: np.ndarray,
+                                          clip_bounds):
+        front_ref = None
+        if self.evaluations_elite is not None and len(self.evaluations_elite) > 0:
+            front_ref = np.asarray(self.evaluations_elite, dtype=float)
+
+        total_budget = max(1, int(self.local_search_beam_max_evals))
+        per_base_budget = max(1, total_budget // max(1, len(bases)))
+        safe_step = np.where(step_vec > 1e-12, step_vec, 1.0)
+        deltas = np.arange(-self.local_search_tube_radius, self.local_search_tube_radius + 1, dtype=float)
+
+        all_neighbors = []
+        all_values = []
+        for base, base_f in zip(bases, base_vals):
+            beam_X = np.asarray([base], dtype=float)
+            beam_F = np.asarray(base_f, dtype=float).reshape(1, -1)
+            remaining = per_base_budget
+
+            for dim in range(self.n_variables):
+                if remaining <= 0:
+                    break
+                step = step_vec[dim]
+                if step <= 0:
+                    continue
+
+                expanded = np.repeat(beam_X, len(deltas), axis=0)
+                expanded[:, dim] += np.tile(deltas * step, len(beam_X))
+                if clip_bounds is not None:
+                    expanded = np.clip(expanded, clip_bounds[0], clip_bounds[1])
+                expanded = np.unique(expanded, axis=0)
+                if len(beam_X) > 0 and len(expanded) > 0:
+                    same = np.all(np.isclose(expanded[:, None, :], beam_X[None, :, :], rtol=0.0, atol=1e-12), axis=2)
+                    expanded = expanded[~np.any(same, axis=1)]
+                if len(expanded) == 0:
+                    continue
+
+                if len(expanded) > remaining:
+                    radius = np.sum(np.abs((expanded - base) / safe_step), axis=1)
+                    expanded = expanded[np.argsort(radius)[:remaining]]
+
+                vals = self._as_2d(self._evaluate_points(cost_function, expanded))
+                remaining -= len(expanded)
+
+                if self.local_search_prune_by_front and front_ref is not None:
+                    expanded, vals = self._prune_dominated_by_front(expanded, vals, front_ref)
+                    if len(expanded) == 0:
+                        continue
+
+                cand_X = np.vstack((beam_X, expanded))
+                cand_F = np.vstack((beam_F, vals))
+                fronts = NSGA2Utils.fast_non_dominated_sort(cand_F)
+                if len(fronts) > 0 and len(fronts[0]) > 0:
+                    idx_nd = np.asarray(fronts[0], dtype=int)
+                    cand_X = cand_X[idx_nd]
+                    cand_F = cand_F[idx_nd]
+
+                beam_X, beam_F = self._select_top_local(cand_X, cand_F, self.local_search_beam_width)
+
+            same_as_base = np.all(np.isclose(beam_X, base, rtol=0.0, atol=1e-12), axis=1)
+            if np.any(~same_as_base):
+                all_neighbors.append(beam_X[~same_as_base])
+                all_values.append(beam_F[~same_as_base])
+
+        if len(all_neighbors) == 0:
+            return np.empty((0, self.n_variables)), np.empty((0, base_vals.shape[1]))
+
+        return np.vstack(all_neighbors), np.vstack(all_values)
+
+    # Perform local search around the current Pareto front, generating neighbors and evaluating them, then selecting the best points to update the elite 
+    # and generation sets.
+    def _local_search_over_front(self, cost_function, clip_bounds):
+        if not self.local_search_enabled or not self._is_multiobjective_dynamic:
+            return
+        if self.elite_temp is None or self.evaluations_elite is None or len(self.elite_temp) == 0:
+            return
+
+        n_elite = len(self.elite_temp)
+        n_points = int(np.ceil(self.local_search_front_ratio * n_elite))
+        n_points = max(1, n_points)
+        n_points = min(n_points, n_elite, self.local_search_max_points)
+
+        chosen = np.linspace(0, n_elite - 1, num=n_points, dtype=int)
+        bases = np.asarray(self.elite_temp[chosen], dtype=float)
+        base_vals = np.asarray(self.evaluations_elite[chosen], dtype=float)
+
+        if clip_bounds is not None:
+            span = np.asarray(clip_bounds[1], dtype=float) - np.asarray(clip_bounds[0], dtype=float)
+        else:
+            span = np.std(np.asarray(self.generation, dtype=float), axis=0)
+        span = np.where(span < 1e-12, 1.0, span)
+        step_vec = self.local_search_step * span
+
+        neighbors = self._local_search_neighbors_gaussian(bases, step_vec, clip_bounds)
+        neigh_vals = self._as_2d(self._evaluate_points(cost_function, neighbors))
+        if self.local_search_prune_by_front:
+            neighbors, neigh_vals = self._prune_dominated_by_front(
+                neighbors, neigh_vals, np.asarray(self.evaluations_elite, dtype=float)
+            )
+
+        if len(neighbors) == 0:
+            return
+
+        pool_X = np.vstack((self.generation, self.elite_temp, neighbors))
+        pool_F = np.vstack((self.evaluations, self.evaluations_elite, neigh_vals))
+
+        self.elite_temp, self.evaluations_elite, self.generation, self.evaluations = self.selection_strategy.select(
+            pool_X, pool_F, self.elite_length, self.truncation_length
+        )
+        self.local_search_calls += 1
+
+    # Ensure that a selection strategy is set, auto-detecting and injecting NSGA-II if the problem appears to be multi-objective based on the shape of evaluations.
+    def _ensure_selection_strategy(self, output_runtime: bool = True) -> bool:
+        if self.selection_strategy is None:
+            if self.evaluations.ndim > 1 and self.evaluations.shape[1] > 1:
+                auto_strategy = NSGA2Selection()
+                self.selection_strategy = auto_strategy
+                self._auto_selection_strategy = True
+                self._auto_selection_strategy_ref = auto_strategy
+        return self.selection_strategy is not None
+
+    # Get the current Pareto front values for multi-objective problems, using the elite evaluations if available, or falling back to the main evaluations.
+    def _get_front_for_metrics(self) -> np.ndarray:
+        if self.selection_strategy is not None and self.evaluations_elite is not None and len(self.evaluations_elite) > 0:
+            return np.asarray(self.evaluations_elite, dtype=float)
+        return np.asarray(self.evaluations, dtype=float)
+
+    @staticmethod
+    def _front_quality_gate_stats(front: np.ndarray):
+        vals = DynamicEDA._as_2d(np.asarray(front, dtype=float))
+        if vals.size == 0 or len(vals) == 0:
+            return {
+                "best_sum": np.inf,
+                "mean_sum": np.inf,
+                "min_sum": np.inf,
+                "size": 0,
+            }
+        row_sums = np.sum(vals, axis=1)
+        per_dim_min = np.min(vals, axis=0)
+        return {
+            "best_sum": float(np.min(row_sums)),
+            "mean_sum": float(np.mean(row_sums)),
+            "min_sum": float(np.sum(per_dim_min)),
+            "size": int(len(vals)),
+        }
+
+    @staticmethod
+    def _front_non_dominated(front: np.ndarray) -> np.ndarray:
+        vals = DynamicEDA._as_2d(np.asarray(front, dtype=float))
+        if vals.size == 0 or len(vals) == 0:
+            return vals
+        fronts = NSGA2Utils.fast_non_dominated_sort(vals)
+        if len(fronts) == 0 or len(fronts[0]) == 0:
+            return vals
+        idx_nd = np.asarray(fronts[0], dtype=int)
+        return vals[idx_nd]
+
+    @staticmethod
+    def _normalize_front_pair(pre_front: np.ndarray, post_front: np.ndarray):
+        pre_vals = DynamicEDA._as_2d(np.asarray(pre_front, dtype=float))
+        post_vals = DynamicEDA._as_2d(np.asarray(post_front, dtype=float))
+        if len(pre_vals) == 0 and len(post_vals) == 0:
+            return pre_vals, post_vals
+        if len(pre_vals) == 0:
+            union = post_vals
+        elif len(post_vals) == 0:
+            union = pre_vals
+        else:
+            union = np.vstack((pre_vals, post_vals))
+        mins = np.min(union, axis=0)
+        spans = np.max(union, axis=0) - mins
+        spans = np.where(spans < 1e-12, 1.0, spans)
+        return (pre_vals - mins) / spans, (post_vals - mins) / spans
+
+    @staticmethod
+    def _dominance_coverage(source_front: np.ndarray, target_front: np.ndarray) -> float:
+        source = DynamicEDA._as_2d(np.asarray(source_front, dtype=float))
+        target = DynamicEDA._as_2d(np.asarray(target_front, dtype=float))
+        if len(source) == 0 or len(target) == 0:
+            return 0.0
+        weak_dom = np.all(source[:, None, :] <= (target[None, :, :] + 1e-12), axis=2)
+        strict_dom = np.any(source[:, None, :] < (target[None, :, :] - 1e-12), axis=2)
+        dominated = np.any(weak_dom & strict_dom, axis=0)
+        return float(np.mean(dominated))
+
+    def _should_revert_multiobjective_reaction_aggregate(self, pre_front: np.ndarray, post_front: np.ndarray) -> bool:
+        pre_stats = self._front_quality_gate_stats(pre_front)
+        post_stats = self._front_quality_gate_stats(post_front)
+        if post_stats["size"] <= 0:
+            return True
+        if pre_stats["size"] <= 0:
+            return False
+
+        allowed_best = max(
+            self.reaction_quality_gate_abs_tol,
+            abs(pre_stats["best_sum"]) * self.reaction_quality_gate_mo_rel_tol,
+        )
+        allowed_mean = max(
+            self.reaction_quality_gate_abs_tol,
+            abs(pre_stats["mean_sum"]) * self.reaction_quality_gate_mo_rel_tol,
+        )
+        allowed_min = max(
+            self.reaction_quality_gate_abs_tol,
+            abs(pre_stats["min_sum"]) * self.reaction_quality_gate_mo_rel_tol,
+        )
+        size_floor = max(1, int(np.floor(pre_stats["size"] * (1.0 - self.reaction_quality_gate_mo_size_tol))))
+
+        worsened_core = (
+            post_stats["best_sum"] > (pre_stats["best_sum"] + allowed_best)
+            and post_stats["mean_sum"] > (pre_stats["mean_sum"] + allowed_mean)
+        )
+        worsened_ideal = post_stats["min_sum"] > (pre_stats["min_sum"] + allowed_min)
+        shrunk_too_much = post_stats["size"] < size_floor
+        return bool((worsened_core and worsened_ideal) or (worsened_ideal and shrunk_too_much))
+
+    def _should_revert_multiobjective_reaction_dominance(self, pre_front: np.ndarray, post_front: np.ndarray) -> bool:
+        pre_nd = self._front_non_dominated(pre_front)
+        post_nd = self._front_non_dominated(post_front)
+        if len(post_nd) == 0:
+            return True
+        if len(pre_nd) == 0:
+            return False
+
+        pre_norm, post_norm = self._normalize_front_pair(pre_nd, post_nd)
+        pre_ideal_sum = float(np.sum(np.min(pre_norm, axis=0)))
+        post_ideal_sum = float(np.sum(np.min(post_norm, axis=0)))
+        allowed_ideal = max(
+            self.reaction_quality_gate_abs_tol,
+            abs(pre_ideal_sum) * self.reaction_quality_gate_mo_rel_tol,
+        )
+        size_floor = max(1, int(np.floor(len(pre_norm) * (1.0 - self.reaction_quality_gate_mo_size_tol))))
+        dominance_margin = max(
+            self.reaction_quality_gate_mo_rel_tol,
+            1.0 / max(len(pre_norm), len(post_norm), 1),
+        )
+
+        pre_covers_post = self._dominance_coverage(pre_norm, post_norm)
+        post_covers_pre = self._dominance_coverage(post_norm, pre_norm)
+        worsened_ideal = post_ideal_sum > (pre_ideal_sum + allowed_ideal)
+        shrunk_too_much = len(post_norm) < size_floor
+        dominance_regressed = pre_covers_post > (post_covers_pre + dominance_margin)
+        return bool(dominance_regressed and (worsened_ideal or shrunk_too_much))
+
+    def _should_revert_multiobjective_reaction_dominance_soft(
+        self, pre_front: np.ndarray, post_front: np.ndarray
+    ) -> bool:
+        pre_nd = self._front_non_dominated(pre_front)
+        post_nd = self._front_non_dominated(post_front)
+        if len(post_nd) == 0:
+            return True
+        if len(pre_nd) == 0:
+            return False
+
+        pre_norm, post_norm = self._normalize_front_pair(pre_nd, post_nd)
+        pre_stats = self._front_quality_gate_stats(pre_norm)
+        post_stats = self._front_quality_gate_stats(post_norm)
+        allowed_mean = max(
+            self.reaction_quality_gate_abs_tol,
+            abs(pre_stats["mean_sum"]) * self.reaction_quality_gate_mo_rel_tol,
+        )
+        allowed_ideal = max(
+            self.reaction_quality_gate_abs_tol,
+            abs(pre_stats["min_sum"]) * self.reaction_quality_gate_mo_rel_tol,
+        )
+        size_floor = max(1, int(np.floor(len(pre_norm) * (1.0 - self.reaction_quality_gate_mo_size_tol))))
+        dominance_margin = max(
+            self.reaction_quality_gate_mo_rel_tol + self.reaction_quality_gate_mo_dominance_margin,
+            1.0 / max(len(pre_norm), len(post_norm), 1),
+        )
+
+        pre_covers_post = self._dominance_coverage(pre_norm, post_norm)
+        post_covers_pre = self._dominance_coverage(post_norm, pre_norm)
+        dominance_regressed = pre_covers_post > (post_covers_pre + dominance_margin)
+        worsened_mean = post_stats["mean_sum"] > (pre_stats["mean_sum"] + allowed_mean)
+        worsened_ideal = post_stats["min_sum"] > (pre_stats["min_sum"] + allowed_ideal)
+        shrunk_too_much = len(post_norm) < size_floor
+        return bool(dominance_regressed and worsened_mean and worsened_ideal and shrunk_too_much)
+
+    def _should_revert_multiobjective_reaction(self, pre_front: np.ndarray, post_front: np.ndarray) -> bool:
+        if not self.reaction_quality_gate_mo_enabled:
+            return False
+        if self.reaction_quality_gate_mo_strategy == "dominance_soft":
+            return self._should_revert_multiobjective_reaction_dominance_soft(pre_front, post_front)
+        if self.reaction_quality_gate_mo_strategy == "dominance":
+            return self._should_revert_multiobjective_reaction_dominance(pre_front, post_front)
+        return self._should_revert_multiobjective_reaction_aggregate(pre_front, post_front)
+
+    # Resolve the clipping bounds for the search space.
+    def _resolve_clip_bounds(self, clip_bounds=None):
+        if clip_bounds is not None:
+            lower_bound, upper_bound = clip_bounds
+        else:
+            init_obj = getattr(self, "init", None)
+            pm_obj = getattr(self, "pm", None)
+            lower_bound = getattr(init_obj, "lower_bound", None)
+            upper_bound = getattr(init_obj, "upper_bound", None)
+            if lower_bound is None and pm_obj is not None:
+                lower_bound = getattr(pm_obj, "lower_bound", None)
+            if upper_bound is None and pm_obj is not None:
+                upper_bound = getattr(pm_obj, "upper_bound", None)
+
+        if lower_bound is None or upper_bound is None:
+            return None
+
+        lower_arr = np.asarray(lower_bound, dtype=float)
+        upper_arr = np.asarray(upper_bound, dtype=float)
+
+        if lower_arr.ndim == 0:
+            lower_arr = np.full(self.n_variables, lower_arr.item(), dtype=float)
+        if upper_arr.ndim == 0:
+            upper_arr = np.full(self.n_variables, upper_arr.item(), dtype=float)
+
+        if lower_arr.shape[0] != self.n_variables or upper_arr.shape[0] != self.n_variables:
+            return None
+
+        return lower_arr, upper_arr
+
+    # Clip the generation points to the specified bounds if they are provided.
+    def _clip_generation(self, clip_bounds):
+        if clip_bounds is None:
+            return
+        self.generation = np.clip(self.generation, clip_bounds[0], clip_bounds[1])
+
+    def _select_sensitive_dims(self, pool: np.ndarray, k: int) -> np.ndarray:
+        pool = np.asarray(pool, dtype=float)
+        if pool.ndim != 2 or len(pool) == 0:
+            return np.arange(min(max(int(k), 1), self.n_variables), dtype=int)
+
+        k = min(max(int(k), 1), self.n_variables)
+        std = np.std(pool, axis=0)
+        if np.all(std <= 1e-12):
+            return np.arange(k, dtype=int)
+        return np.asarray(np.argsort(std)[-k:], dtype=int)
+
+    def _diversity_ratio_for_profile(self, profile: str) -> float:
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            return self.diversity_ratio_mild
+        if profile == "medium":
+            return self.diversity_ratio_medium
+        return self.diversity_ratio_severe
+
+    def _predictive_ratio_for_profile(self, profile: str) -> float:
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            return self.predictive_ratio_mild
+        if profile == "medium":
+            return self.predictive_ratio_medium
+        return self.predictive_ratio_severe
+
+    def _continuity_ratio_for_profile(self, profile: str) -> float:
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            return self.continuity_ratio_mild
+        if profile == "medium":
+            return self.continuity_ratio_medium
+        return self.continuity_ratio_severe
+
+    def _front_ls_ratio_for_profile(self, profile: str) -> float:
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            return self.adr_front_ls_ratio_mild
+        if profile == "medium":
+            return self.adr_front_ls_ratio_medium
+        return self.adr_front_ls_ratio_severe
+
+    def _current_population_anchor(self):
+        if self.elite_temp is not None and len(self.elite_temp) > 0:
+            return np.mean(np.asarray(self.elite_temp, dtype=float), axis=0)
+        if self.generation is not None and len(self.generation) > 0:
+            return np.mean(np.asarray(self.generation, dtype=float), axis=0)
+        return None
+
+    def _record_anchor_history(self):
+        anchor = self._current_population_anchor()
+        if anchor is None:
+            return
+        self._anchor_history.append(np.asarray(anchor, dtype=float).copy())
+
+    def _eda_state_signals(self) -> dict:
+        elite_diversity = 0.0
+        if self.elite_temp is not None and len(self.elite_temp) > 1:
+            elite = np.asarray(self.elite_temp, dtype=float)
+            elite_std = np.mean(np.std(elite, axis=0))
+            if self.generation is not None and len(self.generation) > 1:
+                gen_std = np.mean(np.std(np.asarray(self.generation, dtype=float), axis=0))
+                elite_diversity = float(np.clip(elite_std / max(gen_std, 1e-12), 0.0, 2.0) / 2.0)
+            else:
+                elite_diversity = float(np.clip(elite_std, 0.0, 1.0))
+
+        front_spread = 0.0
+        if self.evaluations_elite is not None and len(self.evaluations_elite) > 1:
+            front = np.asarray(self.evaluations_elite, dtype=float)
+            if front.ndim == 2:
+                front_spread = float(np.clip(np.mean(np.std(front, axis=0)), 0.0, 1.0))
+
+        return {
+            "elite_diversity": float(elite_diversity),
+            "front_spread": float(front_spread),
+        }
+
+    def _continuity_gate_scale(self, profile: str, context: dict | None = None) -> float:
+        if not self.continuity_block_enabled:
+            return 0.0
+        profile = str(profile).strip().lower()
+        regime = str((context or {}).get("regime", "uncertain")).strip().lower()
+        if regime == "stable":
+            base_scale = 1.0
+        elif regime == "abrupt":
+            base_scale = 0.65
+        else:
+            base_scale = 0.85
+        if profile == "mild":
+            base_scale = max(base_scale, 0.90)
+        return float(np.clip(base_scale, 0.0, 1.5))
+
+    def _front_ls_gate_scale(self, profile: str, context: dict | None = None) -> float:
+        if not (self.adr_front_ls_enabled and self.local_search_enabled and self._is_multiobjective_dynamic):
+            return 0.0
+        if not self.adr_front_ls_context_gate_enabled:
+            return 1.0
+
+        regime = str((context or {}).get("regime", "uncertain")).strip().lower()
+        revert_ratio = float(np.clip((context or {}).get("revert_ratio", 0.0), 0.0, 1.0))
+        elite_diversity = float(np.clip((context or {}).get("elite_diversity", 0.0), 0.0, 1.0))
+
+        if regime == "stable":
+            scale = self.adr_front_ls_stable_scale
+        elif regime == "abrupt":
+            scale = self.adr_front_ls_abrupt_scale
+        else:
+            scale = self.adr_front_ls_uncertain_scale
+
+        scale *= max(0.0, 1.0 - self.adr_front_ls_revert_penalty * revert_ratio)
+        scale *= max(0.0, 1.0 - self.adr_front_ls_diversity_penalty * elite_diversity)
+        return float(np.clip(scale, 0.0, 1.5))
+
+    def _build_response_context(self, profile: str, trend_signal: float, change_type: str) -> dict:
+        profile = str(profile).strip().lower()
+        change_type = str(change_type).strip().lower()
+        trend_signal = float(np.clip(trend_signal, 0.0, 1.0))
+        severity_signal = self._severity_fraction()
+        persistence_signal = self._drift_persistence_signal()
+        regularity_signal, last_gap_ratio, gap_count = self._change_regularity_signals()
+        if gap_count < 2:
+            regularity = 0.5
+        else:
+            stable_gap = 1.0 if (0.85 <= last_gap_ratio <= 1.15) else 0.0
+            regularity = float(np.clip(0.7 * regularity_signal + 0.3 * stable_gap, 0.0, 1.0))
+
+        mean_ratio = max(float(getattr(self, "_last_drift_ratio_mean", 0.0)), 0.0)
+        cov_ratio = max(float(getattr(self, "_last_drift_ratio_cov", 0.0)), 0.0)
+        cov_gap = max(cov_ratio - mean_ratio, 0.0) if self.split_drift_signals else 0.0
+        revert_ratio, revert_count = self._reaction_revert_pressure()
+        time_since_last = int(max(self._step_calls - self._last_reaction_step, 0))
+        eda_signals = self._eda_state_signals()
+
+        regime = "uncertain"
+        if change_type == "persistent_like":
+            regime = "stable"
+        elif change_type == "shock_like":
+            regime = "abrupt"
+        elif profile == "mild":
+            regime = "stable"
+        elif (
+            trend_signal >= self.adr_context_stable_trend_min
+            and regularity >= self.adr_context_stable_regularity_min
+            and cov_gap < self.adr_context_abrupt_cov_gap
+        ):
+            regime = "stable"
+        elif (
+            profile == "severe"
+            and cov_gap >= self.adr_context_abrupt_cov_gap
+            and persistence_signal <= self.adr_context_abrupt_persistence_max
+        ):
+            regime = "abrupt"
+
+        return {
+            "regime": regime,
+            "profile": profile,
+            "change_type": change_type,
+            "severity_signal": float(severity_signal),
+            "trend_signal": float(trend_signal),
+            "persistence_signal": float(persistence_signal),
+            "regularity_signal": float(regularity),
+            "cov_gap": float(cov_gap),
+            "mean_ratio": float(mean_ratio),
+            "cov_ratio": float(cov_ratio),
+            "revert_ratio": float(revert_ratio),
+            "revert_count": int(revert_count),
+            "time_since_last_reaction": int(time_since_last),
+            "elite_diversity": float(eda_signals["elite_diversity"]),
+            "front_spread": float(eda_signals["front_spread"]),
+        }
+
+    def _adr_compute_block_weights(self, context: dict) -> dict:
+        regime = str(context.get("regime", "uncertain")).strip().lower()
+        base = np.asarray(self.adr_base_weights.get(regime, self.adr_base_weights["uncertain"]), dtype=float).copy()
+        revert_ratio = float(np.clip(context.get("revert_ratio", 0.0), 0.0, 1.0))
+        severity_signal = float(np.clip(context.get("severity_signal", 0.0), 0.0, 1.0))
+        regularity_signal = float(np.clip(context.get("regularity_signal", 0.5), 0.0, 1.0))
+        elite_diversity = float(np.clip(context.get("elite_diversity", 0.0), 0.0, 1.0))
+        front_spread = float(np.clip(context.get("front_spread", 0.0), 0.0, 1.0))
+
+        # Shift mass away from prediction after repeated poor reactions and toward safer blocks.
+        base[0] *= max(0.0, 1.0 - self.adr_revert_predictive_penalty * revert_ratio)
+        base[1] *= 1.0 + 0.20 * max(0.0, 1.0 - severity_signal) + 0.15 * regularity_signal
+        base[2] *= 1.0 + self.adr_revert_diversity_boost * revert_ratio + 0.20 * severity_signal
+        base[3] *= 1.0 + self.adr_low_diversity_front_ls_boost * max(0.0, 1.0 - elite_diversity) + 0.10 * front_spread
+
+        enabled = np.array([
+            bool(self.predictive_block_enabled),
+            bool(self.continuity_block_enabled),
+            bool(self.diversity_block_enabled),
+            bool(self.adr_front_ls_enabled and self.local_search_enabled and self._is_multiobjective_dynamic),
+        ], dtype=float)
+        base = base * enabled
+        if self.adr_credit_enabled:
+            credit = np.asarray(self._adr_block_credit.get(regime, np.ones(4, dtype=float)), dtype=float)
+            base = base * credit
+        if np.sum(base) <= 1e-12:
+            base = np.zeros(4, dtype=float)
+        else:
+            base = self._normalize_positive_weights(base)
+        return {
+            "predictive": float(base[0]),
+            "continuity": float(base[1]),
+            "diversity": float(base[2]),
+            "front_ls": float(base[3]),
+        }
+
+    def _adr_record_block_state(self, regime: str, weights: dict, counts: dict):
+        regime = str(regime).strip().lower()
+        self._last_reaction_adr_credit_regime = regime
+        credit = np.asarray(self._adr_block_credit.get(regime, np.ones(4, dtype=float)), dtype=float)
+        self._last_reaction_adr_credit_predictive = float(credit[0])
+        self._last_reaction_adr_credit_continuity = float(credit[1])
+        self._last_reaction_adr_credit_diversity = float(credit[2])
+        self._last_reaction_adr_credit_front_ls = float(credit[3])
+
+        total = float(
+            max(
+                int(counts.get("predictive", 0))
+                + int(counts.get("continuity", 0))
+                + int(counts.get("diversity", 0))
+                + int(counts.get("front_ls", 0)),
+                0,
+            )
+        )
+        if total <= 0:
+            usage = np.asarray([
+                max(float(weights.get("predictive", 0.0)), 0.0),
+                max(float(weights.get("continuity", 0.0)), 0.0),
+                max(float(weights.get("diversity", 0.0)), 0.0),
+                max(float(weights.get("front_ls", 0.0)), 0.0),
+            ], dtype=float)
+            if np.sum(usage) > 1e-12:
+                usage = usage / np.sum(usage)
+            else:
+                usage = np.zeros(4, dtype=float)
+        else:
+            usage = np.asarray([
+                int(counts.get("predictive", 0)) / total,
+                int(counts.get("continuity", 0)) / total,
+                int(counts.get("diversity", 0)) / total,
+                int(counts.get("front_ls", 0)) / total,
+            ], dtype=float)
+        self._last_reaction_adr_usage = usage
+
+    def _adr_update_block_credit(self, success: bool | None):
+        if not self.adr_credit_enabled or success is None:
+            return
+        regime = str(getattr(self, "_last_reaction_adr_credit_regime", "none")).strip().lower()
+        if regime not in self._adr_block_credit:
+            return
+        usage = np.asarray(getattr(self, "_last_reaction_adr_usage", np.zeros(4, dtype=float)), dtype=float)
+        if usage.size != 4 or np.sum(usage) <= 1e-12:
+            return
+
+        credit = np.asarray(self._adr_block_credit[regime], dtype=float)
+        if success:
+            target = credit + self.adr_credit_reward * usage
+        else:
+            target = credit - self.adr_credit_penalty * usage
+        target = np.clip(target, self.adr_credit_min, self.adr_credit_max)
+        updated = (1.0 - self.adr_credit_alpha) * credit + self.adr_credit_alpha * target
+        updated = np.clip(updated, self.adr_credit_min, self.adr_credit_max)
+        self._adr_block_credit[regime] = updated
+        self._last_reaction_adr_credit_predictive = float(updated[0])
+        self._last_reaction_adr_credit_continuity = float(updated[1])
+        self._last_reaction_adr_credit_diversity = float(updated[2])
+        self._last_reaction_adr_credit_front_ls = float(updated[3])
+
+    def _adr_allocate_block_counts(self, weights: dict, n_budget: int) -> dict:
+        n_budget = max(int(n_budget), 0)
+        keys = ("predictive", "continuity", "diversity", "front_ls")
+        if n_budget <= 0:
+            return {key: 0 for key in keys}
+
+        weight_vec = np.asarray([max(float(weights.get(key, 0.0)), 0.0) for key in keys], dtype=float)
+        if np.sum(weight_vec) <= 1e-12:
+            return {key: 0 for key in keys}
+        weight_vec = weight_vec / np.sum(weight_vec)
+        raw = weight_vec * n_budget
+        counts = np.floor(raw).astype(int)
+        remainder = n_budget - int(np.sum(counts))
+        if remainder > 0:
+            fractional = raw - counts
+            order = np.argsort(-fractional)
+            for idx in order[:remainder]:
+                counts[idx] += 1
+        return {key: int(counts[i]) for i, key in enumerate(keys)}
+
+    def _diversity_gate_scale(self, profile: str) -> float:
+        if not self.diversity_block_enabled:
+            return 0.0
+        if not self.diversity_gate_enabled:
+            base_scale = 1.0
+        else:
+            profile = str(profile).strip().lower()
+            change_type = str(getattr(self, "_last_change_type", "uncertain")).strip().lower()
+            trend_signal = float(np.clip(getattr(self, "_last_reaction_trend", 0.0), 0.0, 1.0))
+            severity = max(float(getattr(self, "_last_drift_ratio", 1.0)), 1.0)
+            mean_ratio = max(float(getattr(self, "_last_drift_ratio_mean", 0.0)), 0.0)
+            cov_ratio = max(float(getattr(self, "_last_drift_ratio_cov", 0.0)), 0.0)
+            cov_dominant = bool(
+                self.split_drift_signals and cov_ratio >= max(self.diversity_gate_cov_ratio_min, mean_ratio)
+            )
+
+            if profile == "severe":
+                if cov_dominant or trend_signal >= self.diversity_gate_trend_min:
+                    base_scale = 1.0
+                elif severity >= self.diversity_gate_severe_ratio:
+                    base_scale = self.diversity_gate_fallback_scale
+                else:
+                    base_scale = 0.0
+            elif profile == "medium":
+                if cov_dominant and trend_signal >= 0.5 * self.diversity_gate_trend_min:
+                    base_scale = self.diversity_gate_fallback_scale
+                else:
+                    base_scale = 0.0
+            else:
+                base_scale = 0.0
+
+            if self.change_type_enabled:
+                if change_type == "shock_like":
+                    base_scale = min(base_scale, 0.25)
+                elif change_type == "uncertain":
+                    base_scale = min(base_scale, self.diversity_gate_fallback_scale)
+
+        if self.response_mode_enabled:
+            mode = str(getattr(self, "_last_response_mode", "balanced")).strip().lower()
+            if mode == "predictive_bias":
+                base_scale *= self.response_mode_predictive_div_scale
+            elif mode == "defensive":
+                if str(profile).strip().lower() != "mild":
+                    base_scale = max(base_scale, self.response_mode_defensive_div_floor)
+                base_scale *= self.response_mode_defensive_div_scale
+
+        return float(np.clip(base_scale, 0.0, 1.5))
+
+    def _predictive_gate_scale(self, profile: str) -> float:
+        if not self.predictive_block_enabled:
+            return 0.0
+        if len(self._anchor_history) < self.predictive_min_history:
+            return 0.0
+
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            return 0.0
+
+        base_scale = 0.0
+        if not self.change_type_enabled:
+            trend_signal = float(np.clip(getattr(self, "_last_reaction_trend", 0.0), 0.0, 1.0))
+            if trend_signal < self.predictive_trend_min:
+                base_scale = 0.0
+            else:
+                cov_ratio = max(float(getattr(self, "_last_drift_ratio_cov", 0.0)), 0.0)
+                mean_ratio = max(float(getattr(self, "_last_drift_ratio_mean", 0.0)), 0.0)
+                if self.split_drift_signals and cov_ratio > (mean_ratio + 0.25):
+                    base_scale = 0.0
+                elif profile == "severe":
+                    base_scale = 0.75
+                else:
+                    base_scale = 1.0
+        else:
+            change_type = str(getattr(self, "_last_change_type", "uncertain")).strip().lower()
+            if change_type == "shock_like":
+                base_scale = 0.0
+            elif change_type == "uncertain":
+                if self.portfolio_mix_enabled:
+                    regularity_signal, last_gap_ratio, gap_count = self._change_regularity_signals()
+                    stable_gap = 0.85 <= last_gap_ratio <= 1.15
+                    cov_ratio = max(float(getattr(self, "_last_drift_ratio_cov", 0.0)), 0.0)
+                    mean_ratio = max(float(getattr(self, "_last_drift_ratio_mean", 0.0)), 0.0)
+                    irregular_uncertain = bool(
+                        (gap_count >= 2 and (regularity_signal < 0.75 or not stable_gap))
+                        or (self.split_drift_signals and cov_ratio >= mean_ratio + 0.12)
+                    )
+                    if irregular_uncertain:
+                        base_scale = 0.20 if profile == "medium" else 0.15
+            elif change_type == "mixed_like":
+                base_scale = 0.50 if profile == "medium" else 0.35
+            elif profile == "severe":
+                base_scale = 0.75
+            else:
+                base_scale = 1.0
+
+        if (
+            base_scale <= 1e-12
+            and profile != "mild"
+            and self.predictive_strategy in {"sgea", "sgea_centroid", "sgea_relocation"}
+            and self.predictive_sgea_gate_floor > 0.0
+        ):
+            base_scale = self.predictive_sgea_gate_floor
+
+        if self.response_mode_enabled:
+            mode = str(getattr(self, "_last_response_mode", "balanced")).strip().lower()
+            trend_signal = float(np.clip(getattr(self, "_last_reaction_trend", 0.0), 0.0, 1.0))
+            if mode == "defensive":
+                base_scale *= self.response_mode_defensive_pred_scale
+            elif mode == "predictive_bias":
+                if base_scale <= 1e-12 and trend_signal >= self.response_mode_predictive_trend_min:
+                    base_scale = max(base_scale, self.response_mode_predictive_floor)
+                base_scale *= self.response_mode_predictive_scale
+
+        return float(np.clip(base_scale, 0.0, 1.5))
+
+    def _portfolio_mix_scales(self, profile: str):
+        if self.portfolio_mix_enabled:
+            trend_signal = float(np.clip(getattr(self, "_last_reaction_trend", 0.0), 0.0, 1.0))
+            severity_signal = self._severity_fraction()
+            mean_ratio = max(float(getattr(self, "_last_drift_ratio_mean", 0.0)), 0.0)
+            cov_ratio = max(float(getattr(self, "_last_drift_ratio_cov", 0.0)), 0.0)
+            cov_signal = float(np.clip((cov_ratio - mean_ratio) / 0.75, 0.0, 1.0))
+            regularity_signal, last_gap_ratio, gap_count = self._change_regularity_signals()
+
+            if gap_count < 2:
+                regularity = 0.5
+            else:
+                stable_gap = 1.0 if (0.85 <= last_gap_ratio <= 1.15) else 0.0
+                regularity = float(np.clip(0.7 * regularity_signal + 0.3 * stable_gap, 0.0, 1.0))
+            irregularity = float(np.clip(1.0 - regularity, 0.0, 1.0))
+
+            pred_score = (
+                1e-6
+                + self.portfolio_mix_pred_trend_weight * trend_signal
+                + self.portfolio_mix_pred_regularity_weight * regularity
+                + self.portfolio_mix_pred_cov_penalty * max(0.0, 1.0 - cov_signal)
+            )
+            div_score = (
+                1e-6
+                + self.portfolio_mix_div_cov_weight * cov_signal
+                + self.portfolio_mix_div_severity_weight * severity_signal
+                + self.portfolio_mix_div_irregularity_weight * irregularity
+            )
+
+            total = max(pred_score + div_score, 1e-12)
+            pred_scale = 2.0 * pred_score / total
+            div_scale = 2.0 * div_score / total
+
+            if str(profile).strip().lower() == "mild":
+                pred_scale = min(pred_scale, 1.10)
+                div_scale = min(div_scale, 1.10)
+        else:
+            pred_scale = 1.0
+            div_scale = 1.0
+
+        if self.response_mode_enabled:
+            mode = str(getattr(self, "_last_response_mode", "balanced")).strip().lower()
+            if mode == "predictive_bias":
+                pred_scale *= self.response_mode_predictive_scale
+                div_scale *= self.response_mode_predictive_div_scale
+            elif mode == "defensive":
+                pred_scale *= self.response_mode_defensive_pred_scale
+                div_scale *= self.response_mode_defensive_div_scale
+
+        pred_scale = float(np.clip(pred_scale, self.portfolio_mix_min_scale, self.portfolio_mix_max_scale))
+        div_scale = float(np.clip(div_scale, self.portfolio_mix_min_scale, self.portfolio_mix_max_scale))
+        return pred_scale, div_scale
+
+    def _reaction_revert_pressure(self):
+        if len(self._response_revert_history) == 0:
+            return 0.0, 0
+        revert_ratio = float(np.mean(np.asarray(self._response_revert_history, dtype=float)))
+        return revert_ratio, int(len(self._response_revert_history))
+
+    def _select_response_mode(self, profile: str, trend_signal: float, change_type: str) -> str:
+        if not self.response_mode_enabled:
+            return "none"
+
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            return "balanced"
+
+        trend_signal = float(np.clip(trend_signal, 0.0, 1.0))
+        persistence_signal = self._drift_persistence_signal()
+        regularity_signal, last_gap_ratio, gap_count = self._change_regularity_signals()
+        if gap_count < 2:
+            regularity = 0.5
+        else:
+            stable_gap = 1.0 if (0.85 <= last_gap_ratio <= 1.15) else 0.0
+            regularity = float(np.clip(0.7 * regularity_signal + 0.3 * stable_gap, 0.0, 1.0))
+
+        mean_ratio = max(float(getattr(self, "_last_drift_ratio_mean", 0.0)), 0.0)
+        cov_ratio = max(float(getattr(self, "_last_drift_ratio_cov", 0.0)), 0.0)
+        cov_gap = max(cov_ratio - mean_ratio, 0.0) if self.split_drift_signals else 0.0
+        revert_ratio, _ = self._reaction_revert_pressure()
+        change_type = str(change_type).strip().lower()
+
+        if (
+            revert_ratio >= self.response_mode_revert_defensive_ratio
+            or change_type == "shock_like"
+            or (
+                self.split_drift_signals
+                and cov_gap >= self.response_mode_defensive_cov_gap
+                and trend_signal < self.response_mode_predictive_trend_min
+                and persistence_signal <= self.response_mode_defensive_persistence_max
+            )
+        ):
+            return "defensive"
+
+        if (
+            change_type == "persistent_like"
+            or (
+                trend_signal >= self.response_mode_predictive_trend_min
+                and regularity >= self.response_mode_predictive_regularity_min
+                and revert_ratio <= self.response_mode_revert_balanced_ratio
+                and (
+                    (not self.split_drift_signals)
+                    or cov_gap < self.response_mode_defensive_cov_gap
+                )
+            )
+        ):
+            return "predictive_bias"
+
+        return "balanced"
+
+    def _reaction_block_predictive(self, n_samples: int, profile: str, clip_bounds=None) -> np.ndarray:
+        if n_samples <= 0 or len(self._anchor_history) < self.predictive_min_history:
+            return np.empty((0, self.n_variables))
+
+        if self.elite_temp is not None and len(self.elite_temp) > 0:
+            pool = np.asarray(self.elite_temp, dtype=float)
+        elif self.generation is not None and len(self.generation) > 0:
+            pool = np.asarray(self.generation, dtype=float)
+        else:
+            return np.empty((0, self.n_variables))
+
+        if len(pool) == 0:
+            return np.empty((0, self.n_variables))
+
+        prev_anchor = np.asarray(self._anchor_history[-2], dtype=float)
+        curr_anchor = np.asarray(self._anchor_history[-1], dtype=float)
+        velocity = curr_anchor - prev_anchor
+
+        if clip_bounds is not None:
+            lower = np.asarray(clip_bounds[0], dtype=float)
+            upper = np.asarray(clip_bounds[1], dtype=float)
+            span = np.maximum(upper - lower, 1e-12)
+        else:
+            lower = upper = None
+            span = np.maximum(np.std(pool, axis=0), 1.0)
+
+        max_step = self.predictive_max_step_span_ratio * span
+        velocity = np.clip(velocity, -max_step, max_step)
+
+        profile = str(profile).strip().lower()
+        if profile == "medium":
+            profile_mult = 1.0
+        else:
+            profile_mult = 0.75
+
+        base_idx = np.random.choice(len(pool), n_samples, replace=True)
+        predictive = pool[base_idx].copy()
+        local_std = np.std(pool, axis=0)
+        local_std = np.where(local_std < 1e-6, 0.05 * span, local_std)
+        if self.predictive_strategy in {"sgea", "sgea_centroid", "sgea_relocation"}:
+            if self.generation is not None and len(self.generation) > 0:
+                base_pool = np.asarray(self.generation, dtype=float)
+            else:
+                base_pool = pool
+            if len(base_pool) == 0:
+                return np.empty((0, self.n_variables))
+
+            if self.elite_temp is not None and len(self.elite_temp) > 0:
+                elite_pool = np.asarray(self.elite_temp, dtype=float)
+            else:
+                elite_pool = pool
+
+            retained_centroid = np.mean(base_pool, axis=0)
+            archive_centroid = np.mean(elite_pool, axis=0)
+            direction = archive_centroid - retained_centroid
+            direction_norm = float(np.linalg.norm(direction))
+            step_size = float(np.linalg.norm(velocity))
+            if direction_norm <= 1e-12 or step_size <= 1e-12:
+                if clip_bounds is not None:
+                    predictive = lower + np.random.random((n_samples, self.n_variables)) * (upper - lower)
+                else:
+                    base_std = np.std(base_pool, axis=0)
+                    base_std = np.where(base_std < 1e-6, 0.05 * span, base_std)
+                    predictive = np.random.normal(
+                        retained_centroid,
+                        base_std * self.predictive_sgea_noise_scale,
+                        size=(n_samples, self.n_variables),
+                    )
+            else:
+                base_idx = np.random.choice(len(base_pool), n_samples, replace=True)
+                predictive = base_pool[base_idx].copy()
+                step_vector = direction / direction_norm
+                step_vector = step_vector * step_size * self.predictive_step_scale * profile_mult
+                if clip_bounds is not None:
+                    step_vector = np.clip(step_vector, -max_step, max_step)
+                predictive += step_vector
+
+                sigma = (
+                    step_size
+                    / (2.0 * np.sqrt(max(self.n_variables, 1)))
+                    * self.predictive_sgea_noise_scale
+                )
+                if sigma > 0.0:
+                    predictive += np.random.normal(0.0, sigma, size=predictive.shape)
+
+            if clip_bounds is not None:
+                predictive = np.clip(predictive, lower, upper)
+            return predictive
+
+        predictive += velocity * self.predictive_step_scale * profile_mult
+
+        predictive += np.random.normal(
+            0.0,
+            local_std * self.predictive_jitter_scale,
+            size=predictive.shape,
+        )
+
+        if clip_bounds is not None:
+            predictive = np.clip(predictive, lower, upper)
+        return predictive
+
+    def _reaction_block_continuity(self, n_samples: int, profile: str, clip_bounds=None) -> np.ndarray:
+        if n_samples <= 0:
+            return np.empty((0, self.n_variables))
+
+        if self.elite_temp is not None and len(self.elite_temp) > 0:
+            pool = np.asarray(self.elite_temp, dtype=float)
+        elif self.generation is not None and len(self.generation) > 0:
+            pool = np.asarray(self.generation, dtype=float)
+        else:
+            return np.empty((0, self.n_variables))
+
+        if len(pool) == 0:
+            return np.empty((0, self.n_variables))
+
+        if clip_bounds is not None:
+            lower = np.asarray(clip_bounds[0], dtype=float)
+            upper = np.asarray(clip_bounds[1], dtype=float)
+            span = np.maximum(upper - lower, 1e-12)
+        else:
+            lower = upper = None
+            span = np.maximum(np.std(pool, axis=0), 1.0)
+
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            profile_mult = 0.75
+        elif profile == "medium":
+            profile_mult = 1.0
+        else:
+            profile_mult = 1.15
+
+        center = np.mean(pool, axis=0)
+        base_idx = np.random.choice(len(pool), n_samples, replace=True)
+        continuity = pool[base_idx].copy()
+        continuity = center + self.continuity_step_scale * (continuity - center)
+
+        local_std = np.std(pool, axis=0)
+        local_std = np.where(local_std < 1e-6, 0.05 * span, local_std)
+        continuity += np.random.normal(
+            0.0,
+            local_std * self.continuity_jitter_scale * profile_mult,
+            size=continuity.shape,
+        )
+
+        if clip_bounds is not None:
+            continuity = np.clip(continuity, lower, upper)
+        return continuity
+
+    def _reaction_block_front_local_search(self, cost_function, n_samples: int, profile: str, clip_bounds=None):
+        if (
+            n_samples <= 0
+            or (not self.adr_front_ls_enabled)
+            or (not self.local_search_enabled)
+            or (not self._is_multiobjective_dynamic)
+        ):
+            return np.empty((0, self.n_variables)), np.empty((0, 0))
+        if self.elite_temp is None or self.evaluations_elite is None or len(self.elite_temp) == 0:
+            return np.empty((0, self.n_variables)), np.empty((0, 0))
+
+        n_elite = len(self.elite_temp)
+        n_points = max(1, int(np.ceil(n_samples / max(self.local_search_neighbors, 1))))
+        n_points = min(n_points, n_elite, self.local_search_max_points)
+        chosen = np.linspace(0, n_elite - 1, num=n_points, dtype=int)
+        bases = np.asarray(self.elite_temp[chosen], dtype=float)
+
+        if clip_bounds is not None:
+            span = np.asarray(clip_bounds[1], dtype=float) - np.asarray(clip_bounds[0], dtype=float)
+        else:
+            span = np.std(np.asarray(self.generation, dtype=float), axis=0)
+        span = np.where(span < 1e-12, 1.0, span)
+
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            profile_mult = 0.85
+        elif profile == "medium":
+            profile_mult = 1.0
+        else:
+            profile_mult = 1.10
+
+        step_vec = self.adr_front_ls_step_scale * self.local_search_step * profile_mult * span
+        neighbors = self._local_search_neighbors_gaussian(bases, step_vec, clip_bounds)
+        if len(neighbors) == 0:
+            return np.empty((0, self.n_variables)), np.empty((0, 0))
+
+        neigh_vals = self._as_2d(self._evaluate_points(cost_function, neighbors))
+        if self.local_search_prune_by_front:
+            neighbors, neigh_vals = self._prune_dominated_by_front(
+                neighbors, neigh_vals, np.asarray(self.evaluations_elite, dtype=float)
+            )
+        if len(neighbors) == 0:
+            return np.empty((0, self.n_variables)), np.empty((0, 0))
+
+        keep = min(n_samples, len(neighbors))
+        sel_X, sel_F = self._select_top_local(neighbors, neigh_vals, keep)
+        return np.asarray(sel_X, dtype=float), np.asarray(sel_F, dtype=float)
+
+    def _reaction_block_diversity(self, n_samples: int, profile: str, clip_bounds=None) -> np.ndarray:
+        if n_samples <= 0:
+            return np.empty((0, self.n_variables))
+
+        if self.elite_temp is not None and len(self.elite_temp) > 0:
+            pool = np.asarray(self.elite_temp, dtype=float)
+        elif self.generation is not None and len(self.generation) > 0:
+            pool = np.asarray(self.generation, dtype=float)
+        else:
+            return np.empty((0, self.n_variables))
+
+        if len(pool) == 0:
+            return np.empty((0, self.n_variables))
+
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            jitter_mult = 0.60
+            spike_mult = 1.00
+        elif profile == "medium":
+            jitter_mult = 1.00
+            spike_mult = 1.60
+        else:
+            jitter_mult = 1.40
+            spike_mult = 2.20
+
+        if clip_bounds is not None:
+            span = np.asarray(clip_bounds[1], dtype=float) - np.asarray(clip_bounds[0], dtype=float)
+            span = np.where(span < 1e-12, 1.0, span)
+        else:
+            span = np.ones(self.n_variables, dtype=float)
+
+        std = np.std(pool, axis=0)
+        std = np.where(std < 1e-6, 0.05 * span, std)
+        base_step = np.minimum(std, 0.25 * span)
+        base_step = np.where(base_step < 1e-6, 0.05 * span, base_step)
+
+        k_sensitive = max(1, int(np.ceil(self.n_variables * self.diversity_sensitive_dims_ratio)))
+        sensitive_dims = self._select_sensitive_dims(pool, k_sensitive)
+
+        n_jitter = int(round(n_samples * self.diversity_jitter_share))
+        n_spike = int(round(n_samples * self.diversity_spike_share))
+        n_tail = max(0, n_samples - n_jitter - n_spike)
+
+        parts = []
+
+        if n_jitter > 0:
+            base_idx = np.random.choice(len(pool), n_jitter, replace=True)
+            jitter = pool[base_idx].copy()
+            noise = np.random.normal(
+                0.0,
+                base_step * self.diversity_jitter_scale * jitter_mult,
+                size=jitter.shape,
+            )
+            parts.append(jitter + noise)
+
+        if n_spike > 0:
+            base_idx = np.random.choice(len(pool), n_spike, replace=True)
+            spike = pool[base_idx].copy()
+            max_dims = min(3, len(sensitive_dims))
+            for i in range(n_spike):
+                n_dims = np.random.randint(1, max_dims + 1)
+                dims = np.random.choice(sensitive_dims, n_dims, replace=False)
+                for dim in dims:
+                    spike[i, dim] += np.random.normal(
+                        0.0,
+                        base_step[dim] * self.diversity_spike_scale * spike_mult,
+                    )
+            parts.append(spike)
+
+        if n_tail > 0:
+            base_idx = np.random.choice(len(pool), n_tail, replace=True)
+            tail = pool[base_idx].copy()
+            low = np.min(pool, axis=0)
+            high = np.max(pool, axis=0)
+            margin = self.diversity_tail_margin_ratio * np.maximum(high - low, base_step)
+            low = low - margin
+            high = high + margin
+            if clip_bounds is not None:
+                low = np.maximum(low, clip_bounds[0])
+                high = np.minimum(high, clip_bounds[1])
+            widths = np.maximum(high - low, 1e-12)
+            rand_vals = np.random.uniform(size=(n_tail, len(sensitive_dims)))
+            tail[:, sensitive_dims] = low[sensitive_dims] + rand_vals * widths[sensitive_dims]
+            parts.append(tail)
+
+        if len(parts) == 0:
+            return np.empty((0, self.n_variables))
+
+        X = np.vstack(parts)
+        if len(X) < n_samples:
+            fill_idx = np.random.choice(len(pool), n_samples - len(X), replace=True)
+            filler = pool[fill_idx].copy()
+            filler += np.random.normal(
+                0.0,
+                base_step * self.diversity_jitter_scale * jitter_mult,
+                size=filler.shape,
+            )
+            X = np.vstack((X, filler))
+        elif len(X) > n_samples:
+            keep_idx = np.random.choice(len(X), n_samples, replace=False)
+            X = X[keep_idx]
+
+        if clip_bounds is not None:
+            X = np.clip(X, clip_bounds[0], clip_bounds[1])
+
+        return np.asarray(X, dtype=float)
+
+    # Build a memory snapshot of the current elite or generation points and their evaluations, storing them in the memory archive for potential future reuse.
+    def _build_memory_snapshot(self):
+        if not self.memory_enabled:
+            return
+        if self.generation is None or len(self.generation) == 0:
+            return
+
+        source_x = None
+        source_f = None
+        if self.elite_temp is not None and len(self.elite_temp) > 0:
+            source_x = np.asarray(self.elite_temp, dtype=float)
+            source_f = np.asarray(self.evaluations_elite, dtype=float)
+        elif self.evaluations is not None and len(self.evaluations) > 0:
+            source_x = np.asarray(self.generation, dtype=float)
+            source_f = np.asarray(self.evaluations, dtype=float)
+
+        if source_x is None or len(source_x) == 0:
+            return
+
+        top_k = min(self.memory_topk, len(source_x))
+        if top_k <= 0:
+            return
+
+        snapshot_f = None
+        if source_f is None or len(np.asarray(source_f)) == 0:
+            idx = np.arange(top_k, dtype=int)
+            snapshot_x = source_x[idx]
+        else:
+            source_f = np.asarray(source_f, dtype=float)
+            if source_f.ndim == 1:
+                idx = np.argsort(source_f)[:top_k]
+                snapshot_x = source_x[idx]
+                snapshot_f = source_f[idx]
+            else:
+                if self.selection_strategy is not None:
+                    sel_x, _, _, _ = self.selection_strategy.select(source_x, source_f, top_k, top_k)
+                    snapshot_x = np.asarray(sel_x, dtype=float)
+                    if len(snapshot_x) > 0:
+                        picked = []
+                        for row in snapshot_x:
+                            dist = np.linalg.norm(source_x - row, axis=1)
+                            picked.append(int(np.argmin(dist)))
+                        snapshot_f = source_f[np.asarray(picked, dtype=int)]
+                else:
+                    idx = np.argsort(np.sum(source_f, axis=1))[:top_k]
+                    snapshot_x = source_x[idx]
+                    snapshot_f = source_f[idx]
+
+        if len(snapshot_x) == 0:
+            return
+
+        anchor = np.mean(snapshot_x, axis=0)
+        self.memory_archive.append({
+            "anchor": np.asarray(anchor, dtype=float),
+            "solutions": np.asarray(snapshot_x, dtype=float),
+            "objectives": None if snapshot_f is None else np.asarray(snapshot_f, dtype=float),
+            "step": int(self._step_calls),
+        })
+        if len(self.memory_archive) > self.memory_max_size:
+            self.memory_archive = self.memory_archive[-self.memory_max_size:]
+
+    # Inject solutions from the memory archive into the current generation.
+    def _inject_memory_if_match(self, clip_bounds=None):
+        self._last_memory_reused = False
+        if not self.memory_enabled or self.memory_inject_ratio <= 0.0:
+            return
+        if self.generation is None or len(self.generation) == 0:
+            return
+        if len(self.memory_archive) < self.memory_min_archive_size:
+            return
+        if self.memory_min_interval > 0:
+            if (self._step_calls - self._last_memory_inject_step) < self.memory_min_interval:
+                return
+        if len(self.memory_archive) == 0:
+            return
+
+        current_anchor = np.mean(self.generation, axis=0)
+        if clip_bounds is not None:
+            scale = np.asarray(clip_bounds[1], dtype=float) - np.asarray(clip_bounds[0], dtype=float)
+        else:
+            scale = np.std(self.generation, axis=0)
+        scale = np.where(scale < 1e-12, 1.0, scale)
+
+        best_entry = None
+        best_distance = np.inf
+        for entry in self.memory_archive:
+            # Avoid reusing snapshots created in the same step.
+            entry_step = int(entry.get("step", -10**9))
+            if entry_step >= self._step_calls:
+                continue
+            delta = (current_anchor - entry["anchor"]) / scale
+            dist = float(np.linalg.norm(delta) / np.sqrt(self.n_variables))
+            if dist < best_distance:
+                best_distance = dist
+                best_entry = entry
+
+        if best_entry is None or best_distance > self.memory_match_threshold:
+            return
+
+        memory_solutions = np.asarray(best_entry["solutions"], dtype=float)
+        if len(memory_solutions) == 0:
+            return
+
+        n_pop = len(self.generation)
+        n_mem_target = int(self.size_gen * self.memory_inject_ratio)
+        n_mem = min(max(n_mem_target, 1), len(memory_solutions), n_pop)
+        if n_mem <= 0:
+            return
+
+        if len(memory_solutions) > n_mem:
+            pick_idx = np.random.choice(len(memory_solutions), n_mem, replace=False)
+            memory_batch = memory_solutions[pick_idx].copy()
+        else:
+            memory_batch = memory_solutions.copy()
+
+        if clip_bounds is not None:
+            memory_batch = np.clip(memory_batch, clip_bounds[0], clip_bounds[1])
+
+        replace_idx = np.random.choice(n_pop, n_mem, replace=False)
+        self.generation[replace_idx] = memory_batch
+
+        self.memory_hits += 1
+        self._last_memory_inject_step = self._step_calls
+        self._last_memory_reused = True
+
+        if self.disp:
+            print(
+                f" [Dynamic] Memory reinjection applied "
+                f"(distance={best_distance:.3f}, injected={n_mem}, archive={len(self.memory_archive)})"
+            )
+
+    # =====================================================
+    #  0. INITIAL SETUP FOR DYNAMIC OPTIMIZATION
+    # =====================================================
+    def setup_dynamic(self, cost_function, output_runtime: bool = False):
+
+        self._reset_dynamic_state()
+        if self._auto_selection_strategy and self.selection_strategy is self._auto_selection_strategy_ref:
+            self.selection_strategy = None
+        self._auto_selection_strategy = False
+        self._auto_selection_strategy_ref = None
+
+        self.generation = self._initialize_generation()
+        self.elite_temp = np.empty((0, self.n_variables))
+        self.evaluations_elite = np.array([])
+
+        self._check_generation(cost_function)
+
+        self._is_multiobjective_dynamic = self._ensure_selection_strategy(output_runtime=output_runtime)
+
+        if self._is_multiobjective_dynamic:
+            self.evaluations_elite = np.empty((0, self.evaluations.shape[1]))
+            self._truncation()
+        else:
+            best_idx = np.argmin(self.evaluations)
+            self.best_mae_global = self.evaluations[best_idx]
+            self.best_ind_global = self.generation[best_idx]
+            if output_runtime:
+                print(f"IT: 0\tBest cost: {self.best_mae_global:.4f}")
+
+        self._update_sentinels(force=True)
+        self._record_anchor_history()
+        self._is_initialized_dynamic = True
+
+        return {
+            "is_multiobjective": self._is_multiobjective_dynamic,
+            "front": self._get_front_for_metrics().copy(),
+            "best_cost": None if self._is_multiobjective_dynamic else float(self.best_mae_global),
+            "current_best_cost": None if self._is_multiobjective_dynamic else float(self.best_mae_global),
+            "env_changes": int(self.env_changes),
+            "ewma": float(self.ewma_stat),
+            "ewma_cov": float(self.ewma_cov_stat),
+            "drift_ratio": float(self._last_drift_ratio),
+            "drift_ratio_mean": float(self._last_drift_ratio_mean),
+            "drift_ratio_cov": float(self._last_drift_ratio_cov),
+            "reaction_severity": float(self._last_reaction_severity),
+        }
+
+    # =====================================================
+    #  1. UPDATE SENTINELS AND DETECTOR BASELINE
+    # =====================================================
+    def _update_sentinels(self, force: bool = False):
+
+        need_refresh = force or self.sentinel_genomes is None or self._sentinel_age >= self.sentinel_refresh
+        if not need_refresh:
+            self._sentinel_age += 1
+            return
+
+        pop_size = len(self.generation)
+        k = min(self.n_sentinels, pop_size)
+        if k == 0:
+            self.sentinel_indices = np.array([], dtype=int)
+            self.sentinel_genomes = np.empty((0, self.n_variables))
+            self._sentinel_age = 0
+            return
+
+        self.sentinel_indices = np.random.choice(pop_size, k, replace=False)
+        self.sentinel_genomes = self.generation[self.sentinel_indices].copy()
+
+        sent_fit = self._as_2d(self.evaluations[self.sentinel_indices])
+
+        if self.normalize_objectives:
+            scale = np.std(sent_fit, axis=0)
+            scale[scale < self.detector_scale_eps] = 1.0
+            self.obj_scale = scale
+            sent_fit_for_detector = sent_fit / self.obj_scale
+        else:
+            self.obj_scale = np.ones(sent_fit.shape[1], dtype=float)
+            sent_fit_for_detector = sent_fit
+
+        self.mu_old = np.mean(sent_fit_for_detector, axis=0)
+        self.cov_old = self._regularize_covariance(self._cov_from_samples(sent_fit_for_detector))
+        self._sentinel_age = 0
+
+    # =====================================================
+    #  2. DETECT ENVIRONMENTAL CHANGES 
+    # =====================================================
+    def _detect_change(self, cost_function) -> bool:
+        if self.sentinel_genomes is None or self.mu_old is None or self.cov_old is None:
+            return False
+
+        self._detect_calls += 1
+        if self._cooldown_left > 0:
+            self._cooldown_left -= 1
+
+        sentinel_genomes = self.sentinel_genomes
+        new_vals = self._as_2d(self._evaluate_points(cost_function, sentinel_genomes))
+
+        if self.normalize_objectives:
+            scale = self.obj_scale if self.obj_scale is not None else np.ones(new_vals.shape[1], dtype=float)
+            new_vals = new_vals / scale
+
+        mu_new = np.mean(new_vals, axis=0)
+        cov_new = self._regularize_covariance(self._cov_from_samples(new_vals))
+        dof = mu_new.shape[0]
+
+        if self.split_drift_signals:
+            n_prev = self.sentinel_genomes.shape[0]
+            n_curr = new_vals.shape[0]
+            mean_score = self._hotelling_t2(self.mu_old, mu_new, self.cov_old, cov_new, n_prev, n_curr)
+            alpha_mean = self.drift_alpha_mean
+        else:
+            diff = mu_new - self.mu_old
+            inv_cov = self._stable_inverse(self.cov_old)
+            mean_score = self._as_scalar(diff.T @ inv_cov @ diff)
+            alpha_mean = self.drift_alpha
+
+        self._last_drift_mean_score = float(mean_score)
+        ewma_mean = self._update_ewma_channel(mean_score, channel="mean")
+        threshold_mean = chi2.ppf(1 - alpha_mean, dof)
+        threshold_mean = max(float(threshold_mean), 1e-12)
+        self._last_drift_ratio_mean = float(ewma_mean / threshold_mean)
+
+        self._last_drift_cov_score = 0.0
+        self._last_drift_cov_threshold = np.inf
+        self._last_drift_ratio_cov = 0.0
+        cov_hit = False
+        threshold_cov = np.inf
+        if self.split_drift_signals:
+            cov_score = self._stein_divergence(self.cov_old, cov_new)
+            self._last_drift_cov_score = float(cov_score)
+            ewma_cov = self._update_ewma_channel(cov_score, channel="cov")
+            threshold_cov = self._cov_threshold()
+            self._last_drift_cov_threshold = float(threshold_cov)
+            if np.isfinite(threshold_cov):
+                self._last_drift_ratio_cov = float(ewma_cov / max(threshold_cov, self.cov_threshold_floor))
+                cov_hit = bool(ewma_cov > threshold_cov)
+        else:
+            self.ewma_cov_stat = 0.0
+
+        mean_hit = bool(ewma_mean > threshold_mean)
+        if self.split_drift_signals:
+            if self.split_drift_hit_mode == "and":
+                hit = mean_hit and cov_hit
+            else:
+                hit = mean_hit or cov_hit
+        else:
+            hit = mean_hit
+
+        if self.split_drift_signals and (not hit) and np.isfinite(self.ewma_cov_stat):
+            self._cov_baseline_ewma.append(float(self.ewma_cov_stat))
+
+        self._last_drift_ratio = float(max(self._last_drift_ratio_mean, self._last_drift_ratio_cov))
+        self._drift_ratio_history.append(float(self._last_drift_ratio))
+
+        rearm_threshold = threshold_mean * self.detector_rearm_ratio
+        if not self._detector_armed:
+            if ewma_mean <= rearm_threshold:
+                self._detector_armed = True
+            else:
+                return False
+
+        if hit:
+            self._consecutive_alerts += 1
+        else:
+            self._consecutive_alerts = 0
+
+        if self._consecutive_alerts < self.k_consecutive:
+            return False
+
+        if self._cooldown_left > 0:
+            return False
+
+        if self.min_change_interval > 0:
+            delta = self._detect_calls - self._last_change_detect_call
+            if delta < self.min_change_interval:
+                return False
+
+        self._last_change_detect_call = self._detect_calls
+        self._change_step_history.append(int(self._step_calls))
+        cooldown_steps = self.alert_cooldown
+        if self.adaptive_cooldown_enabled:
+            sev_ref = max(self.adaptive_cooldown_severity_ref, 1.01)
+            sev_frac = np.clip((self._last_drift_ratio - 1.0) / (sev_ref - 1.0), 0.0, 1.0)
+            cd_low = max(self.adaptive_cooldown_low, self.adaptive_cooldown_high)
+            cd_high = min(self.adaptive_cooldown_low, self.adaptive_cooldown_high)
+            adaptive_cd = int(round(cd_low - sev_frac * (cd_low - cd_high)))
+            cooldown_steps = max(cooldown_steps, adaptive_cd)
+        self._cooldown_left = max(0, int(cooldown_steps))
+        self._detector_armed = False
+
+        if self.disp:
+            if self.split_drift_signals:
+                cov_thr_txt = f"{threshold_cov:.4f}" if np.isfinite(threshold_cov) else "warmup"
+                print(
+                    f" [Dynamic] Drift detectado "
+                    f"(mean={self.ewma_stat:.4f}/{threshold_mean:.4f}, "
+                    f"cov={self.ewma_cov_stat:.4f}/{cov_thr_txt}, "
+                    f"ratio={self._last_drift_ratio:.2f}, k={self._consecutive_alerts}, "
+                    f"rearm={rearm_threshold:.4f}, mode={self.split_drift_hit_mode})"
+                )
+            else:
+                print(
+                    f" [Dynamic] Drift detectado "
+                    f"(EWMA: {self.ewma_stat:.4f} > Chi2: {threshold_mean:.4f}, "
+                    f"ratio={self._last_drift_ratio:.2f}, k={self._consecutive_alerts}, "
+                    f"rearm={rearm_threshold:.4f})"
+                )
+
+        return True
+
+    # =====================================================
+    #  3. REACT TO CHANGES WITH ADAPTIVE PROFILES AND MEMORY
+    # =====================================================
+    
+    # Compute a severity fraction between 0 and 1 based on how much the last drift ratio exceeds the threshold, normalized by the configured severity range.
+    def _severity_fraction(self) -> float:
+        severity = max(float(self._last_drift_ratio), 1.0)
+        span = max(self.severity_high - 1.0, 1e-12)
+        return float(np.clip((severity - 1.0) / span, 0.0, 1.0))
+
+    # Determine the budget limit for reactions based on the specified profile, mapping "mild", "medium", and "severe" to their respective configured limits.
+    def _profile_budget_limit(self, profile: str) -> int:
+        profile = str(profile).strip().lower()
+        if profile == "mild":
+            return self.reaction_max_calls_mild_window
+        if profile == "medium":
+            return self.reaction_max_calls_medium_window
+        return self.reaction_max_calls_severe_window
+
+    # Compute a trend signal between 0 and 1 based on the recent history of best costs, measuring how much the recent average cost has worsened compared to the previous window, normalized by a configured scale.
+    def _compute_trend_signal(self) -> float:
+        # Positive trend means recent best cost worsens versus previous window.
+        hist = self._pre_step_best_history
+        w = max(2, int(self.adaptive_trend_window))
+        if len(hist) < (w + 1):
+            return 0.0
+
+        recent = float(np.mean(hist[-w:]))
+        prev_start = max(0, len(hist) - 2 * w)
+        prev_values = hist[prev_start:len(hist) - w]
+        if len(prev_values) == 0:
+            return 0.0
+        prev = float(np.mean(prev_values))
+        if not np.isfinite(recent) or not np.isfinite(prev):
+            return 0.0
+
+        worsening = (recent - prev) / max(abs(prev), 1e-12)
+        return float(np.clip(worsening / 0.10, 0.0, 1.0))
+
+    def _drift_persistence_signal(self) -> float:
+        if len(self._drift_ratio_history) == 0:
+            return 0.0
+
+        window = min(len(self._drift_ratio_history), max(3, self.k_consecutive + 1))
+        recent = list(self._drift_ratio_history)[-window:]
+        ref = max(self.severity_high - 1.0, 1e-12)
+        excess = [max(float(r) - 1.0, 0.0) / ref for r in recent]
+        return float(np.clip(np.mean(excess), 0.0, 1.0))
+
+    def _change_regularity_signals(self):
+        if len(self._change_step_history) < 3:
+            return 0.0, 1.0, 0
+
+        steps = np.asarray(self._change_step_history, dtype=float)
+        gaps = np.diff(steps)
+        if len(gaps) < 2:
+            return 0.0, 1.0, int(len(gaps))
+
+        mean_gap = float(np.mean(gaps))
+        if mean_gap <= 1e-12:
+            return 0.0, 1.0, int(len(gaps))
+
+        cv = float(np.std(gaps) / mean_gap)
+        regularity = float(np.clip(1.0 - cv, 0.0, 1.0))
+        last_gap_ratio = float(gaps[-1] / max(float(np.median(gaps)), 1e-12))
+        return regularity, last_gap_ratio, int(len(gaps))
+
+    def _classify_change_type(self, profile: str, trend_signal: float) -> str:
+        if not (self.change_type_enabled or self.adr_enabled):
+            return "none"
+
+        profile = str(profile).strip().lower()
+        trend_signal = float(np.clip(trend_signal, 0.0, 1.0))
+        severity = max(float(getattr(self, "_last_drift_ratio", 1.0)), 1.0)
+        mean_ratio = max(float(getattr(self, "_last_drift_ratio_mean", 0.0)), 0.0)
+        cov_ratio = max(float(getattr(self, "_last_drift_ratio_cov", 0.0)), 0.0)
+        cov_gap = cov_ratio - mean_ratio
+        persistence_signal = self._drift_persistence_signal()
+        regularity_signal, last_gap_ratio, gap_count = self._change_regularity_signals()
+        gap_history_ready = gap_count >= 2
+        stable_gap = 0.85 <= last_gap_ratio <= 1.15
+
+        if not self.split_drift_signals:
+            if gap_history_ready and regularity_signal >= 0.80 and stable_gap and trend_signal >= 0.05:
+                return "persistent_like"
+            return "uncertain"
+
+        if (
+            gap_history_ready
+            and regularity_signal >= 0.80
+            and stable_gap
+            and trend_signal >= 0.05
+            and cov_gap <= 0.10
+        ):
+            return "persistent_like"
+
+        if (
+            profile != "mild"
+            and cov_ratio >= max(self.diversity_gate_cov_ratio_min, mean_ratio + 0.12)
+            and trend_signal < 0.15
+            and persistence_signal < 0.35
+            and (
+                (gap_history_ready and (regularity_signal < 0.70 or not stable_gap))
+                or (gap_count == 1 and cov_gap >= 0.30 and trend_signal < 0.08)
+            )
+        ):
+            return "shock_like"
+
+        if (
+            cov_ratio >= self.diversity_gate_cov_ratio_min
+            and (
+                (trend_signal >= 0.10 and persistence_signal >= 0.20)
+                or (gap_history_ready and (regularity_signal < 0.80 or not stable_gap))
+            )
+        ):
+            return "mixed_like"
+
+        return "uncertain"
+
+    # Select the appropriate reaction profile ("mild", "medium", "severe") based on a combined score of severity, recency, and trend signals, 
+    # using the configured weights and thresholds to determine the profile.
+    def _select_adaptive_profile(self):
+        sev_signal = self._severity_fraction()
+        recency_steps = self._step_calls - self._last_reaction_step
+        rec_signal = float(np.clip(recency_steps / max(self.adaptive_recency_scale, 1), 0.0, 1.0))
+        trend_signal = self._compute_trend_signal()
+
+        score = (
+            self.adaptive_weight_severity * sev_signal
+            + self.adaptive_weight_recency * rec_signal
+            + self.adaptive_weight_trend * trend_signal
+        )
+
+        if score >= self.profile_threshold_severe or self._last_drift_ratio >= self.severity_high:
+            profile = "severe"
+        elif score >= self.profile_threshold_medium:
+            profile = "medium"
+        else:
+            profile = "mild"
+
+        change_type = self._classify_change_type(profile, trend_signal)
+        response_mode = self._select_response_mode(profile, trend_signal, change_type)
+        return profile, float(score), float(trend_signal), change_type, response_mode
+
+    # React to detected change: reset detector and inject immigrants.
+    def _react(self, cost_function=None, profile: str = "severe", clip_bounds=None):
+        self.env_changes += 1
+        self.ewma_stat = 0.0
+        self.ewma_cov_stat = 0.0
+        self._consecutive_alerts = 0
+        self._last_memory_reused = False
+        self._last_reaction_diversity_count = 0
+        self._last_reaction_diversity_scale = 0.0
+        self._last_reaction_predictive_count = 0
+        self._last_reaction_predictive_scale = 0.0
+        self._last_reaction_continuity_count = 0
+        self._last_reaction_continuity_scale = 0.0
+        self._last_reaction_front_ls_count = 0
+        self._last_reaction_front_ls_scale = 0.0
+        self._last_reaction_portfolio_mix_predictive = 1.0
+        self._last_reaction_portfolio_mix_diversity = 1.0
+        self._last_reaction_adr_context = "none"
+        self._last_reaction_adr_predictive_weight = 0.0
+        self._last_reaction_adr_continuity_weight = 0.0
+        self._last_reaction_adr_diversity_weight = 0.0
+        self._last_reaction_adr_front_ls_weight = 0.0
+
+        # Save current context for possible future recurrent shifts.
+        self._build_memory_snapshot()
+
+        # Severidad basada en cuanto excede el umbral en la detección.
+        severity = max(self._last_drift_ratio, 1.0)
+        self._last_reaction_severity = float(severity)
+        frac = self._severity_fraction()
+
+        if self.adaptive_policy_enabled:
+            profile = str(profile).strip().lower()
+            if profile == "mild":
+                base_sigma = self.react_strength_mild
+                base_imm = self.immigrant_ratio_mild
+            elif profile == "medium":
+                base_sigma = self.react_strength_medium
+                base_imm = self.immigrant_ratio_medium
+            else:
+                profile = "severe"
+                base_sigma = self.react_strength
+                base_imm = self.immigrant_ratio
+
+            react_sigma = max(base_sigma * (1.0 + 0.15 * frac), 1e-12)
+            imm_ratio = float(np.clip(base_imm * (1.0 + 0.20 * frac), 0.0, 1.0))
+        else:
+            react_sigma = self.react_strength_mild + frac * (self.react_strength - self.react_strength_mild)
+            imm_ratio = self.immigrant_ratio_mild + frac * (self.immigrant_ratio - self.immigrant_ratio_mild)
+
+        n_pop = int(len(self.generation))
+        n_imm_target = int(self.size_gen * imm_ratio)
+        n_imm = min(n_imm_target, n_pop)
+
+        if self.disp:
+            print(
+                f" [Dynamic] Reaccion iniciada (Cambio #{self.env_changes}) "
+                f"[profile={self._last_reaction_profile}, severity={severity:.2f}, "
+                f"score={self._last_reaction_score:.2f}, sigma_x{react_sigma:.2f}, immigrants={n_imm}]"
+            )
+
+        # A. Reseteo parcial del modelo probabilístico (solo para gaussianas)
+        if hasattr(self.pm, 'pm') and isinstance(self.pm.pm, np.ndarray) and self.pm.pm.ndim == 2 and self.pm.pm.shape[0] >= 2:
+            self.pm.pm[1, :] *= react_sigma
+            self.pm.pm[1, :] = np.maximum(self.pm.pm[1, :], 1.0)
+
+        # B. Inyección de inmigrantes híbridos
+        if n_imm > 0 and n_pop > 0:
+            mean = np.mean(self.generation, axis=0)
+            std = np.std(self.generation, axis=0)
+            std[std < 1e-3] = 0.1
+
+            immigrants_parts = []
+            n_pred = 0
+            n_cont = 0
+            n_div = 0
+            n_front_ls = 0
+            mix_pred, mix_div = self._portfolio_mix_scales(profile)
+            self._last_reaction_portfolio_mix_predictive = float(mix_pred)
+            self._last_reaction_portfolio_mix_diversity = float(mix_div)
+            if self.adr_enabled:
+                adr_context = self._build_response_context(
+                    profile=profile,
+                    trend_signal=float(self._last_reaction_trend),
+                    change_type=str(getattr(self, "_last_change_type", "none")),
+                )
+                self._last_reaction_adr_context = str(adr_context["regime"])
+                adr_weights = self._adr_compute_block_weights(adr_context)
+                self._last_reaction_adr_predictive_weight = float(adr_weights["predictive"])
+                self._last_reaction_adr_continuity_weight = float(adr_weights["continuity"])
+                self._last_reaction_adr_diversity_weight = float(adr_weights["diversity"])
+                self._last_reaction_adr_front_ls_weight = float(adr_weights["front_ls"])
+
+                pred_scale = self._predictive_gate_scale(profile)
+                div_scale = self._diversity_gate_scale(profile)
+                cont_scale = self._continuity_gate_scale(profile, adr_context)
+                front_ls_scale = self._front_ls_gate_scale(profile, adr_context)
+                self._last_reaction_predictive_scale = float(pred_scale)
+                self._last_reaction_diversity_scale = float(div_scale)
+                self._last_reaction_continuity_scale = float(cont_scale)
+                self._last_reaction_front_ls_scale = float(front_ls_scale)
+
+                gated_weights = {
+                    "predictive": adr_weights["predictive"] * pred_scale,
+                    "continuity": adr_weights["continuity"] * cont_scale,
+                    "diversity": adr_weights["diversity"] * div_scale,
+                    "front_ls": adr_weights["front_ls"] * front_ls_scale,
+                }
+                n_adr_budget = min(n_imm, max(int(round(n_imm * self.adr_block_budget_ratio)), 0))
+                adr_counts = self._adr_allocate_block_counts(gated_weights, n_adr_budget)
+                n_pred = int(adr_counts["predictive"])
+                n_cont = int(adr_counts["continuity"])
+                n_div = int(adr_counts["diversity"])
+                n_front_ls = int(adr_counts["front_ls"])
+
+                if n_pred > 0:
+                    predictive_block = self._reaction_block_predictive(
+                        n_samples=n_pred,
+                        profile=profile,
+                        clip_bounds=clip_bounds,
+                    )
+                    if len(predictive_block) > 0:
+                        immigrants_parts.append(predictive_block)
+                        self._last_reaction_predictive_count = int(len(predictive_block))
+
+                if n_cont > 0:
+                    continuity_block = self._reaction_block_continuity(
+                        n_samples=n_cont,
+                        profile=profile,
+                        clip_bounds=clip_bounds,
+                    )
+                    if len(continuity_block) > 0:
+                        immigrants_parts.append(continuity_block)
+                        self._last_reaction_continuity_count = int(len(continuity_block))
+
+                if n_div > 0:
+                    diversity_block = self._reaction_block_diversity(
+                        n_samples=n_div,
+                        profile=profile,
+                        clip_bounds=clip_bounds,
+                    )
+                    if len(diversity_block) > 0:
+                        immigrants_parts.append(diversity_block)
+                        self._last_reaction_diversity_count = int(len(diversity_block))
+
+                if n_front_ls > 0 and cost_function is not None:
+                    front_ls_block, front_ls_vals = self._reaction_block_front_local_search(
+                        cost_function=cost_function,
+                        n_samples=n_front_ls,
+                        profile=profile,
+                        clip_bounds=clip_bounds,
+                    )
+                    if len(front_ls_block) > 0:
+                        immigrants_parts.append(front_ls_block)
+                        self._last_reaction_front_ls_count = int(len(front_ls_block))
+                        if (
+                            self.selection_strategy is not None
+                            and self.evaluations_elite is not None
+                            and len(front_ls_vals) > 0
+                        ):
+                            pool_X = np.vstack((self.generation, self.elite_temp, front_ls_block))
+                            pool_F = np.vstack((self.evaluations, self.evaluations_elite, front_ls_vals))
+                            self.elite_temp, self.evaluations_elite, self.generation, self.evaluations = (
+                                self.selection_strategy.select(
+                                    pool_X, pool_F, self.elite_length, self.truncation_length
+                                )
+                                )
+                            self.local_search_calls += 1
+                self._adr_record_block_state(
+                    self._last_reaction_adr_context,
+                    gated_weights,
+                    {
+                        "predictive": self._last_reaction_predictive_count,
+                        "continuity": self._last_reaction_continuity_count,
+                        "diversity": self._last_reaction_diversity_count,
+                        "front_ls": self._last_reaction_front_ls_count,
+                    },
+                )
+            else:
+                if self.predictive_block_enabled:
+                    pred_scale = self._predictive_gate_scale(profile)
+                    pred_scale *= mix_pred
+                    self._last_reaction_predictive_scale = float(pred_scale)
+                    n_pred_target = int(self.size_gen * self._predictive_ratio_for_profile(profile) * pred_scale)
+                    n_pred = min(n_imm, max(n_pred_target, 0))
+                    if n_pred > 0:
+                        predictive_block = self._reaction_block_predictive(
+                            n_samples=n_pred,
+                            profile=profile,
+                            clip_bounds=clip_bounds,
+                        )
+                        if len(predictive_block) > 0:
+                            immigrants_parts.append(predictive_block)
+                            self._last_reaction_predictive_count = int(len(predictive_block))
+                if self.diversity_block_enabled:
+                    div_scale = self._diversity_gate_scale(profile)
+                    div_scale *= mix_div
+                    self._last_reaction_diversity_scale = float(div_scale)
+                    n_div_target = int(self.size_gen * self._diversity_ratio_for_profile(profile) * div_scale)
+                    n_div_budget = max(0, n_imm - sum(len(part) for part in immigrants_parts))
+                    n_div = min(n_div_budget, max(n_div_target, 0))
+                    if n_div > 0:
+                        diversity_block = self._reaction_block_diversity(
+                            n_samples=n_div,
+                            profile=profile,
+                            clip_bounds=clip_bounds,
+                        )
+                        if len(diversity_block) > 0:
+                            immigrants_parts.append(diversity_block)
+                            self._last_reaction_diversity_count = int(len(diversity_block))
+
+            n_remaining = max(0, n_imm - sum(len(part) for part in immigrants_parts))
+            if n_remaining > 0:
+                n_gauss = n_remaining // 2
+                gaussian_imm = np.random.normal(mean, std * react_sigma, (n_gauss, self.n_variables))
+
+                n_uniform = n_remaining - n_gauss
+                if clip_bounds is not None:
+                    min_gen, max_gen = clip_bounds
+                else:
+                    min_gen = np.min(self.generation, axis=0) - 5.0
+                    max_gen = np.max(self.generation, axis=0) + 5.0
+                uniform_imm = np.random.uniform(min_gen, max_gen, (n_uniform, self.n_variables))
+                immigrants_parts.extend([gaussian_imm, uniform_imm])
+
+            immigrants = np.vstack([part for part in immigrants_parts if len(part) > 0]) if immigrants_parts else np.empty((0, self.n_variables))
+            if len(immigrants) > 0:
+                idx = np.random.choice(n_pop, len(immigrants), replace=False)
+                self.generation[idx] = immigrants
+
+        # C. Optional memory reinjection for recurrent contexts.
+        self._inject_memory_if_match(clip_bounds=clip_bounds)
+        self._clip_generation(clip_bounds)
+
+    # Stabilize the detector state when a change is detected but reaction is not applied.
+    def _stabilize_detector_without_reaction(self):
+        """
+        Si la reacción está desactivada, consume la alerta y reancla centinelas
+        para evitar múltiples detecciones sobre el mismo cambio ambiental.
+        """
+        self.ewma_stat = 0.0
+        self.ewma_cov_stat = 0.0
+        self._consecutive_alerts = 0
+        self._update_sentinels(force=True)
+
+    # Prune the reaction history to only keep steps within the configured reaction window, ensuring that the reaction budget is correctly enforced.
+    def _prune_reaction_window(self):
+        if self.reaction_window <= 0:
+            return
+        min_step = self._step_calls - self.reaction_window + 1
+        self._reaction_steps = [s for s in self._reaction_steps if s >= min_step]
+        for profile in self._reaction_profile_steps:
+            self._reaction_profile_steps[profile] = [
+                s for s in self._reaction_profile_steps[profile] if s >= min_step
+            ]
+
+    # Check if a reaction can be applied based on the current drift severity, reaction interval, and reaction window budgets, 
+    # returning a boolean and a reason string.
+    def _can_apply_reaction(self, profile: str = "severe"):
+        if self._last_drift_ratio < self.reaction_min_drift_ratio:
+            return False, "low_severity"
+
+        if self.reaction_min_interval > 0:
+            if (self._step_calls - self._last_reaction_step) < self.reaction_min_interval:
+                return False, "min_interval"
+
+        if self.reaction_window > 0:
+            self._prune_reaction_window()
+            if self.reaction_max_calls_in_window > 0 and len(self._reaction_steps) >= self.reaction_max_calls_in_window:
+                return False, "window_budget"
+            profile_budget = self._profile_budget_limit(profile)
+            profile_steps = self._reaction_profile_steps.get(profile, [])
+            if profile_budget > 0 and len(profile_steps) >= profile_budget:
+                return False, f"profile_budget_{profile}"
+
+        return True, "ok"
+
+    # ============================================================================
+    #  4. MAIN MINIMIZE FUNCTION TO RUN THE OPTIMIZATION LOOP AND COLLECT HISTORY
+    # ============================================================================
+    def minimize(self, cost_function, output_runtime=True, ftol=1e-8, *args, **kwargs):
+        history = []
+        t1 = time.process_time()
+        atol = max(float(ftol), 0.0)
+        clip_bounds = kwargs.pop("clip_bounds", None)
+
+        init_info = self.setup_dynamic(cost_function, output_runtime=output_runtime)
+        dead_iter_counter = 0
+        previous_front = np.asarray(init_info["front"], dtype=float).copy() if init_info["is_multiobjective"] else None
+        previous_best = None if init_info["is_multiobjective"] else float(init_info["best_cost"])
+
+        if not init_info["is_multiobjective"]:
+            history.append(init_info["best_cost"])
+
+        for i in range(1, self.max_iter):
+            step_info = self.step(cost_function, with_reaction=True, ftol=ftol, clip_bounds=clip_bounds)
+
+            if not init_info["is_multiobjective"]:
+                history.append(step_info["best_cost"])
+                current_best = float(step_info["best_cost"])
+                if (previous_best - current_best) > atol:
+                    dead_iter_counter = 0
+                else:
+                    dead_iter_counter += 1
+                previous_best = current_best
+
+                if self.dead_iter > 0 and dead_iter_counter >= self.dead_iter:
+                    if output_runtime:
+                        print(f"IT {i} | Stop by dead_iter (SO)")
+                    break
+
+                if output_runtime and i % 5 == 0:
+                    print(f"IT {i} | Best: {self.best_mae_global:.6f} | EWMA: {self.ewma_stat:.2e}")
+            else:
+                current_front = np.asarray(step_info["front"], dtype=float)
+                if self._front_has_changed(previous_front, current_front, atol):
+                    dead_iter_counter = 0
+                else:
+                    dead_iter_counter += 1
+                previous_front = current_front.copy()
+
+                if self.dead_iter > 0 and dead_iter_counter >= self.dead_iter:
+                    if output_runtime:
+                        print(f"IT {i} | Stop by dead_iter (MO)")
+                    break
+
+                if output_runtime and i % 10 == 0:
+                    print(f"IT {i} | Elite Archive Size: {len(self.evaluations_elite)} | EWMA: {self.ewma_stat:.2e}")
+
+        t2 = time.process_time()
+
+        if init_info["is_multiobjective"]:
+            return {
+                "pareto_set": self.elite_temp,
+                "pareto_front": self.evaluations_elite,
+                "cpu_time": t2 - t1,
+                "env_changes": self.env_changes,
+                "settings": self.export_settings()
+            }
+
+        from .eda_result import EdaResult
+        return EdaResult(self.best_ind_global, self.best_mae_global, len(history) * self.size_gen,
+                         history, self.export_settings(), t2 - t1)
+
+    # =====================================================================
+    #  MAIN STEP FUNCTION TO PERFORM DETECTION, REACTION, AND EVOLUTION
+    # =====================================================================
+    def step(self,
+             cost_function,
+             with_reaction: bool = True,
+             ftol: float = 1e-8,
+             clip_bounds=None) -> dict:
+
+        if not self._is_initialized_dynamic:
+            self.setup_dynamic(cost_function, output_runtime=False)
+
+        atol = max(float(ftol), 0.0)
+        effective_clip_bounds = self._resolve_clip_bounds(clip_bounds)
+        self._step_calls += 1
+        self._last_memory_reused = False
+        self._last_reaction_profile = "none"
+        self._last_reaction_score = 0.0
+        self._last_reaction_trend = 0.0
+        self._last_reaction_quality_reverted = False
+        self._last_reaction_diversity_count = 0
+        self._last_reaction_diversity_scale = 0.0
+        self._last_reaction_predictive_count = 0
+        self._last_reaction_predictive_scale = 0.0
+        self._last_reaction_continuity_count = 0
+        self._last_reaction_continuity_scale = 0.0
+        self._last_reaction_front_ls_count = 0
+        self._last_reaction_front_ls_scale = 0.0
+        self._last_reaction_adr_context = "none"
+        self._last_reaction_adr_predictive_weight = 0.0
+        self._last_reaction_adr_continuity_weight = 0.0
+        self._last_reaction_adr_diversity_weight = 0.0
+        self._last_reaction_adr_front_ls_weight = 0.0
+        self._last_reaction_adr_credit_regime = "none"
+        self._last_reaction_adr_credit_predictive = 1.0
+        self._last_reaction_adr_credit_continuity = 1.0
+        self._last_reaction_adr_credit_diversity = 1.0
+        self._last_reaction_adr_credit_front_ls = 1.0
+        self._last_reaction_adr_usage = np.zeros(4, dtype=float)
+        self._last_response_mode = "none"
+        self._last_response_mode_revert_pressure = 0.0
+
+        if (not self._is_multiobjective_dynamic) and self.evaluations is not None and len(self.evaluations) > 0:
+            current_best_pre = float(np.min(self.evaluations))
+            self._pre_step_best_history.append(current_best_pre)
+            max_hist = max(8, 3 * self.adaptive_trend_window)
+            if len(self._pre_step_best_history) > max_hist:
+                self._pre_step_best_history = self._pre_step_best_history[-max_hist:]
+
+        change_detected = self._detect_change(cost_function)
+        reaction_applied = False
+        self._last_reaction_block_reason = "none"
+        if change_detected and with_reaction:
+            if self.adaptive_policy_enabled:
+                profile, score, trend_signal, change_type, response_mode = self._select_adaptive_profile()
+            else:
+                profile = "severe" if self._last_drift_ratio >= self.severity_high else "mild"
+                score = self._severity_fraction()
+                trend_signal = 0.0
+                change_type = self._classify_change_type(profile, trend_signal)
+                response_mode = self._select_response_mode(profile, trend_signal, change_type)
+
+            self._last_reaction_profile = profile
+            self._last_reaction_score = float(score)
+            self._last_reaction_trend = float(trend_signal)
+            self._last_change_type = str(change_type)
+            self._last_response_mode = str(response_mode)
+            revert_ratio, _ = self._reaction_revert_pressure()
+            self._last_response_mode_revert_pressure = float(revert_ratio)
+
+            can_react, reason = self._can_apply_reaction(profile=profile)
+            if can_react:
+                backup = None
+                pre_best_cost = None
+                if self.reaction_quality_gate_enabled:
+                    pre_front = None
+                    if self._is_multiobjective_dynamic:
+                        pre_front = self._get_front_for_metrics().copy()
+                    else:
+                        pre_best_cost = float(np.min(self.evaluations))
+                    pm_backup = None
+                    if hasattr(self.pm, "pm") and isinstance(self.pm.pm, np.ndarray):
+                        pm_backup = self.pm.pm.copy()
+                    eval_backup = None
+                    if self.evaluations is not None:
+                        eval_backup = self.evaluations.copy()
+                    backup = {
+                        "generation": self.generation.copy(),
+                        "evaluations": eval_backup,
+                        "pm": pm_backup,
+                        "env_changes": int(self.env_changes),
+                        "elite_temp": None if self.elite_temp is None else self.elite_temp.copy(),
+                        "evaluations_elite": (
+                            None if self.evaluations_elite is None else self.evaluations_elite.copy()
+                        ),
+                        "front": pre_front,
+                    }
+
+                self._react(cost_function=cost_function, profile=profile, clip_bounds=effective_clip_bounds)
+                self._check_generation(cost_function)
+
+                quality_reverted = False
+                if backup is not None:
+                    if pre_best_cost is not None:
+                        post_best_cost = float(np.min(self.evaluations))
+                        allowed_delta = max(
+                            self.reaction_quality_gate_abs_tol,
+                            abs(pre_best_cost) * self.reaction_quality_gate_rel_tol,
+                        )
+                        quality_reverted = bool(post_best_cost > (pre_best_cost + allowed_delta))
+                    elif self._is_multiobjective_dynamic and backup["front"] is not None:
+                        self._truncation()
+                        post_front = self._get_front_for_metrics().copy()
+                        quality_reverted = self._should_revert_multiobjective_reaction(
+                            backup["front"], post_front
+                        )
+
+                    if quality_reverted:
+                        self.generation = backup["generation"]
+                        self.evaluations = backup["evaluations"]
+                        self.elite_temp = backup["elite_temp"]
+                        self.evaluations_elite = backup["evaluations_elite"]
+                        if backup["pm"] is not None:
+                            self.pm.pm = backup["pm"]
+                        self.env_changes = int(backup["env_changes"])
+                        self._last_memory_reused = False
+                        self._last_reaction_quality_reverted = True
+                        self._last_reaction_block_reason = "quality_gate_revert"
+                        self._response_revert_history.append(1.0)
+                        self._adr_update_block_credit(success=False)
+                        self._stabilize_detector_without_reaction()
+
+                if not quality_reverted:
+                    self._update_sentinels(force=True)
+                    self._last_reaction_step = self._step_calls
+                    self._reaction_steps.append(self._step_calls)
+                    self._reaction_profile_steps.setdefault(profile, []).append(self._step_calls)
+                    self._prune_reaction_window()
+                    self._response_revert_history.append(0.0)
+                    self._adr_update_block_credit(success=True)
+                    reaction_applied = True
+            else:
+                self._last_reaction_block_reason = reason
+                self._stabilize_detector_without_reaction()
+        elif change_detected and not with_reaction:
+            self._last_reaction_block_reason = "reaction_disabled"
+            self._stabilize_detector_without_reaction()
+
+        # Evolución estándar: primero consolidar frente/padres sobre población actual
+        self._truncation()
+        self._local_search_over_front(cost_function, effective_clip_bounds)
+        front_for_metrics = self._get_front_for_metrics().copy()
+
+        if self.w_noise > 0:
+            self.generation += np.random.normal(0, self.w_noise, self.generation.shape)
+            self._clip_generation(effective_clip_bounds)
+
+        self._update_pm()
+        self._new_generation()
+        self._clip_generation(effective_clip_bounds)
+        self._check_generation(cost_function)
+        self._record_anchor_history()
+
+        best_cost = None
+        current_best_cost = None
+        if not self._is_multiobjective_dynamic:
+            current_best_cost = float(np.min(self.evaluations))
+            if (self.best_mae_global - current_best_cost) > atol:
+                self.best_mae_global = current_best_cost
+                self.best_ind_global = self.generation[np.argmin(self.evaluations)]
+            best_cost = float(self.best_mae_global)
+
+        # moving window de centinelas
+        self._update_sentinels()
+
+        return {
+            "change_detected": bool(change_detected),
+            "front": front_for_metrics,
+            "best_cost": best_cost,
+            "current_best_cost": current_best_cost,
+            "is_multiobjective": bool(self._is_multiobjective_dynamic),
+            "env_changes": int(self.env_changes),
+            "ewma": float(self.ewma_stat),
+            "ewma_cov": float(self.ewma_cov_stat),
+            "drift_ratio": float(self._last_drift_ratio),
+            "drift_ratio_mean": float(self._last_drift_ratio_mean),
+            "drift_ratio_cov": float(self._last_drift_ratio_cov),
+            "drift_mean_score": float(self._last_drift_mean_score),
+            "drift_cov_score": float(self._last_drift_cov_score),
+            "drift_cov_threshold": float(self._last_drift_cov_threshold),
+            "lambda_ewma_mean_last": float(self._last_lambda_mean),
+            "lambda_ewma_cov_last": float(self._last_lambda_cov),
+            "cooldown_left": int(self._cooldown_left),
+            "consecutive_alerts": int(self._consecutive_alerts),
+            "reaction_severity": float(self._last_reaction_severity),
+            "reaction_applied": bool(reaction_applied),
+            "reaction_profile": self._last_reaction_profile,
+            "reaction_change_type": self._last_change_type,
+            "reaction_score": float(self._last_reaction_score),
+            "reaction_trend_signal": float(self._last_reaction_trend),
+            "reaction_diversity_count": int(self._last_reaction_diversity_count),
+            "reaction_diversity_scale": float(self._last_reaction_diversity_scale),
+            "reaction_predictive_count": int(self._last_reaction_predictive_count),
+            "reaction_predictive_scale": float(self._last_reaction_predictive_scale),
+            "reaction_continuity_count": int(self._last_reaction_continuity_count),
+            "reaction_continuity_scale": float(self._last_reaction_continuity_scale),
+            "reaction_front_ls_count": int(self._last_reaction_front_ls_count),
+            "reaction_front_ls_scale": float(self._last_reaction_front_ls_scale),
+            "reaction_portfolio_mix_predictive": float(self._last_reaction_portfolio_mix_predictive),
+            "reaction_portfolio_mix_diversity": float(self._last_reaction_portfolio_mix_diversity),
+            "reaction_adr_context": self._last_reaction_adr_context,
+            "reaction_adr_predictive_weight": float(self._last_reaction_adr_predictive_weight),
+            "reaction_adr_continuity_weight": float(self._last_reaction_adr_continuity_weight),
+            "reaction_adr_diversity_weight": float(self._last_reaction_adr_diversity_weight),
+            "reaction_adr_front_ls_weight": float(self._last_reaction_adr_front_ls_weight),
+            "reaction_adr_credit_regime": self._last_reaction_adr_credit_regime,
+            "reaction_adr_credit_predictive": float(self._last_reaction_adr_credit_predictive),
+            "reaction_adr_credit_continuity": float(self._last_reaction_adr_credit_continuity),
+            "reaction_adr_credit_diversity": float(self._last_reaction_adr_credit_diversity),
+            "reaction_adr_credit_front_ls": float(self._last_reaction_adr_credit_front_ls),
+            "reaction_response_mode": self._last_response_mode,
+            "reaction_response_mode_revert_pressure": float(self._last_response_mode_revert_pressure),
+            "reaction_quality_reverted": bool(self._last_reaction_quality_reverted),
+            "reaction_block_reason": self._last_reaction_block_reason,
+            "local_search_calls": int(self.local_search_calls),
+            "memory_reused": bool(self._last_memory_reused),
+            "memory_archive_size": int(len(self.memory_archive)),
+            "memory_hits": int(self.memory_hits),
+        }
+
+    # ===================================================================================
+    # MAIN FUNCTION TO RUN DYNAMIC OPTIMIZATION FOR MULTIPLE STEPS AND COLLECT HISTORY
+    # ===================================================================================
+    def run_dynamic(self,
+                    cost_function,
+                    n_steps: int,
+                    with_reaction: bool = True,
+                    ftol: float = 1e-8,
+                    clip_bounds=None,
+                    advance_environment=None,
+                    output_runtime: bool = False) -> dict:
+
+        self.setup_dynamic(cost_function, output_runtime=output_runtime)
+
+        history = []
+        detected_steps = []
+
+        for step_idx in range(n_steps):
+            info = self.step(cost_function, with_reaction=with_reaction, ftol=ftol, clip_bounds=clip_bounds)
+            history.append(info)
+            if info["change_detected"]:
+                detected_steps.append(step_idx)
+            if advance_environment is not None:
+                advance_environment(step_idx, info)
+
+        return {
+            "history": history,
+            "detected_steps": detected_steps,
+            "env_changes": int(self.env_changes),
+            "is_multiobjective": bool(self._is_multiobjective_dynamic),
+        }
+
